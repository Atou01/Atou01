# En-têtes servis par Cloudflare Pages (fichiers statiques et pages HTML).
# La Content-Security-Policy n'est pas écrite ici : astro.config.mjs l'ajoute au build sous
# « /* », avec l'empreinte de chaque script en ligne recalculée à chaque fois.
# Ces règles ne s'appliquent pas aux réponses construites par les fonctions (/api/*) :
# server/html.js pose ses propres en-têtes. Voir docs/formulaire-et-fonctions.md.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Logo (en-tête et pied de chaque page) et image de partage : noms non versionnés,
# gardés une semaine / un jour en cache. Changer le nom du fichier si son contenu change.
/brand/*
  Cache-Control: public, max-age=604800

/og-image.jpg
  Cache-Control: public, max-age=86400

/exemples/rivage/*
  X-Robots-Tag: noindex, nofollow

/exemples/faitage/*
  X-Robots-Tag: noindex, nofollow

/exemples/ecluse/*
  X-Robots-Tag: noindex, nofollow

/exemples/lueur/*
  X-Robots-Tag: noindex, nofollow

/exemples/moellon/*
  X-Robots-Tag: noindex, nofollow
