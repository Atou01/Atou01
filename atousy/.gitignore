# Le .gitignore racine du dépôt ignore package.json / package-lock.json / index.html :
# on les réautorise pour ce projet.
!package.json
!package-lock.json
!index.html

node_modules/
dist/
.astro/
.wrangler/
# Secrets locaux de wrangler, y compris par environnement (.dev.vars.preview…)
.dev.vars*
!.dev.vars.example
.env
.env.*
!.env.example
*.log
.DS_Store
