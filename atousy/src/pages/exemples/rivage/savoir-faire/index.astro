---
// Rivage — paysagiste fictif : « Savoir-faire » (démonstration Atousy).
import { Picture } from 'astro:assets';
import RivageLayout from '../../../../components/demos/rivage/RivageLayout.astro';
import PageIntro from '../../../../components/demos/rivage/PageIntro.astro';
import ContactBand from '../../../../components/demos/rivage/ContactBand.astro';
import pathImg from '../../../../assets/photos/rivage-1.jpg';
import terraceImg from '../../../../assets/photos/rivage-2.jpg';
import grassesImg from '../../../../assets/photos/rivage-3.jpg';
import wallImg from '../../../../assets/photos/rivage-4.jpg';
import pondImg from '../../../../assets/photos/rivage-5.jpg';
import winterImg from '../../../../assets/photos/rivage-6.jpg';

const services = [
  {
    id: 'conception',
    short: 'Conception',
    title: 'Conception de jardin',
    text: 'Relevé du terrain, esquisse d’ambiance, plan de plantation : nous dessinons un jardin à votre mesure, avant le premier coup de bêche. Vous savez exactement où vous allez.',
    items: ['Visite et relevé du terrain', 'Esquisse et planches d’ambiance', 'Plan détaillé et palette végétale', 'Choix des matériaux'],
    img: pathImg,
    alt: 'Allée en pierre sinueuse entre graminées et lavandes, sous des arbres, dans la lumière du soir.',
    pos: '50% 60%',
  },
  {
    id: 'plantation',
    short: 'Plantation',
    title: 'Plantation et massifs',
    text: 'Vivaces, graminées, arbustes et arbres sont choisis pour le sol et l’exposition, puis associés pour fleurir en relais, du printemps jusqu’à l’hiver.',
    items: ['Préparation et amendement du sol', 'Massifs de vivaces et de graminées', 'Haies libres et arbres', 'Paillage naturel'],
    img: grassesImg,
    alt: 'Échinacées roses, sauges violettes et graminées dorées en contre-jour.',
    pos: '30% 50%',
  },
  {
    id: 'pierre-seche',
    short: 'Pierre sèche',
    title: 'Murets en pierre sèche',
    text: 'Montés sans mortier, à l’ancienne, les murets retiennent la terre, structurent les pentes et deviennent un refuge pour les plantes et la petite faune.',
    items: ['Murets de soutènement', 'Terrasses sur terrain en pente', 'Murets plantés', 'Restauration de murs anciens'],
    img: wallImg,
    alt: 'Muret en pierre sèche dont les joints accueillent thym, fougères et petites fleurs.',
    pos: '40% 50%',
  },
  {
    id: 'bassins',
    short: 'Bassins naturels',
    title: 'Bassins naturels',
    text: 'Un point d’eau sans produit chimique, filtré par les plantes. Nénuphars, iris et joncs y trouvent leur place, et le jardin gagne en fraîcheur et en vie.',
    items: ['Bassins d’agrément', 'Zones de filtration plantées', 'Berges en pierre et plantées', 'Mares pour la biodiversité'],
    img: pondImg,
    alt: 'Bassin naturel aux eaux claires, bordé de pierres et d’iris, avec des nénuphars en fleur.',
    pos: '50% 55%',
  },
  {
    id: 'terrasses',
    short: 'Terrasses',
    title: 'Terrasses et cheminements',
    text: 'Dallages en pierre naturelle, pas japonais, platelages en bois : des lieux pour s’asseoir et des chemins qui invitent à la promenade.',
    items: ['Terrasses en pierre naturelle', 'Allées et pas japonais', 'Platelages en bois', 'Éclairage discret des chemins'],
    img: terraceImg,
    alt: 'Terrasse pavée de pierre avec deux fauteuils en bois, entourée de lavandes, face à un lac.',
    pos: '35% 60%',
  },
  {
    id: 'entretien',
    short: 'Entretien',
    title: 'Entretien au fil des saisons',
    text: 'Taille douce, désherbage manuel, soin des massifs : un entretien respectueux, qui laisse le jardin évoluer sans le brusquer.',
    items: ['Visites saisonnières', 'Taille des arbustes et des haies', 'Rabattage des vivaces et graminées', 'Conseils pour entretenir vous-même'],
    img: winterImg,
    alt: 'Jardin en hiver, graminées et vivaces couvertes de givre le long d’une allée.',
    pos: '40% 55%',
  },
];
---

<RivageLayout
  title="Savoir-faire — Rivage, démonstration fictive | Atousy"
  description="Les savoir-faire de Rivage, paysagiste fictif : conception, plantation, murets en pierre sèche, bassins naturels, terrasses et entretien. Démonstration Atousy."
  current="savoir-faire"
>
  <PageIntro
    title="Savoir-faire"
    lead="De la conception à l’entretien, un seul interlocuteur pour faire naître votre jardin et l’accompagner dans le temps."
  >
    <nav class="toc" aria-label="Sur cette page">
      <ul>
        {
          services.map((s) => (
            <li>
              <a href={`#${s.id}`}>{s.short}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </PageIntro>

  <div class="services rv-container">
    {
      services.map((s, i) => (
        <section class:list={['service', { 'service--flip': i % 2 === 1 }]} id={s.id} aria-labelledby={`${s.id}-title`}>
          <div class="service__media">
            <Picture
              src={s.img}
              alt={s.alt}
              formats={['avif', 'webp']}
              widths={[480, 800, 1200, 1500]}
              sizes="(max-width: 56em) calc(100vw - 2.5rem), (max-width: 80em) 52vw, 41rem"
              style={`object-position: ${s.pos}`}
            />
          </div>
          <div class="service__text">
            <span class="service__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')} / {String(services.length).padStart(2, '0')}
            </span>
            <h2 id={`${s.id}-title`} class="rv-h2">
              {s.title}
            </h2>
            <p class="service__desc">{s.text}</p>
            <h3 class="service__label">Ce que cela comprend</h3>
            <ul class="service__list">
              {s.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </div>

  <ContactBand
    title="Un projet, une question ?"
    text="Création complète, transformation d’un coin du jardin ou simple entretien : dites-nous ce dont vous avez besoin."
  />
</RivageLayout>

<style>
  .toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .toc a {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border: 1px solid rgb(30 51 40 / 0.25);
    border-radius: 999px;
    color: var(--rv-green);
    font-size: 0.875rem;
    font-weight: 550;
    text-decoration: none;
    transition:
      background-color 0.25s var(--rv-ease),
      color 0.25s var(--rv-ease);
  }

  .toc a:hover {
    background: var(--rv-green);
    color: var(--rv-ivory);
  }

  .services {
    display: grid;
    gap: clamp(4.5rem, 9vw, 8rem);
    padding-block: clamp(1rem, 3vw, 2rem) clamp(5rem, 10vw, 8.5rem);
  }

  .service {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    align-items: center;
    gap: 2.5rem clamp(2.5rem, 6vw, 6rem);
  }

  .service--flip .service__media {
    order: 2;
  }

  .service__media {
    overflow: hidden;
    aspect-ratio: 5 / 4;
    border-radius: var(--rv-radius);
    background: var(--rv-ivory-2);
  }

  .service__media :global(picture) {
    display: block;
    height: 100%;
  }

  .service__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service__text {
    max-width: 32rem;
  }

  .service__num {
    display: block;
    margin-bottom: 1rem;
    font-family: var(--rv-serif);
    font-style: italic;
    color: var(--rv-green-3);
  }

  .service h2 {
    margin-bottom: 1.25rem;
  }

  .service__desc {
    color: var(--rv-ink-2);
    font-size: 1.125rem;
  }

  .service__label {
    margin: 2rem 0 0.9rem;
    font-family: var(--rv-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--rv-green-3);
  }

  .service__list {
    display: grid;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rv-line);
  }

  .service__list li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--rv-line);
  }

  .service__list li::before {
    content: '';
    flex: none;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--rv-green-3);
    border-radius: 50%;
    opacity: 0.7;
  }

  @media (max-width: 56em) {
    .service {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .service--flip .service__media {
      order: 0;
    }

    .service__media {
      aspect-ratio: 3 / 2;
    }

    .service__text {
      max-width: none;
    }
  }
</style>
