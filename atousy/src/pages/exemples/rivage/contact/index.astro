---
// Rivage — paysagiste fictif : « Nous contacter » (démonstration Atousy).
// Formulaire volontairement désactivé : aucun envoi, aucun script.
import { Picture } from 'astro:assets';
import RivageLayout from '../../../../components/demos/rivage/RivageLayout.astro';
import PageIntro from '../../../../components/demos/rivage/PageIntro.astro';
import RealSiteNote from '../../../../components/demos/rivage/RealSiteNote.astro';
import Icon from '../../../../components/Icon.astro';
import pondImg from '../../../../assets/photos/rivage-5.jpg';

const projectTypes = [
  { value: 'creation', label: 'Créer un jardin' },
  { value: 'transformation', label: 'Transformer un jardin existant' },
  { value: 'entretien', label: 'Faire entretenir mon jardin' },
  { value: 'autre', label: 'Autre demande' },
];

const next = [
  { title: 'Nous lisons votre message', text: 'Avec attention, pour comprendre votre lieu et vos envies.' },
  { title: 'Nous vous rappelons', text: 'Pour en parler de vive voix et répondre à vos premières questions.' },
  { title: 'Nous venons voir le jardin', text: 'Rien ne remplace une visite sur place pour bien commencer.' },
];
---

<RivageLayout
  title="Nous contacter — Rivage, démonstration fictive | Atousy"
  description="Contacter Rivage, paysagiste fictif. Page de démonstration réalisée par Atousy : le formulaire est volontairement désactivé."
  current="contact"
>
  <PageIntro
    title="Nous contacter"
    lead="Parlez-nous de votre jardin : ce que vous aimez, ce qui vous manque, la façon dont vous aimeriez y vivre."
  />

  <section class="contact" aria-label="Formulaire et informations de contact">
    <div class="rv-container contact__grid">
      <form class="form" aria-describedby="form-disabled-note" novalidate>
        <p class="form__note" id="form-disabled-note" role="note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5M12 8h.01" />
          </svg>
          <span><strong>Formulaire désactivé :</strong> ceci est une démonstration.</span>
        </p>

        <fieldset class="form__fields" disabled>
          <legend class="form__legend">Votre demande</legend>

          <div class="row">
            <div class="field">
              <label for="rv-name">Prénom et nom</label>
              <input id="rv-name" name="name" type="text" autocomplete="name" disabled />
            </div>
            <div class="field">
              <label for="rv-email">Adresse e-mail</label>
              <input id="rv-email" name="email" type="email" autocomplete="email" disabled />
            </div>
          </div>

          <div class="field">
            <label for="rv-phone">Téléphone <span class="optional">(facultatif)</span></label>
            <input id="rv-phone" name="phone" type="tel" autocomplete="tel" disabled />
          </div>

          <fieldset class="choices" disabled>
            <legend>Votre projet</legend>
            <div class="choices__list">
              {
                projectTypes.map((t, i) => (
                  <label class="choice">
                    <input type="radio" name="project" value={t.value} checked={i === 0} disabled />
                    <span>{t.label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="field">
            <label for="rv-message">Votre message</label>
            <textarea id="rv-message" name="message" rows="6" placeholder="Décrivez votre jardin, vos envies, vos contraintes…" disabled></textarea>
          </div>

          <label class="consent">
            <input type="checkbox" name="consent" disabled />
            <span>J’accepte que ces informations soient utilisées pour être recontacté au sujet de ma demande.</span>
          </label>

          <button class="rv-btn form__submit" type="submit" disabled>
            Envoyer ma demande <Icon name="arrow" />
          </button>
        </fieldset>
      </form>

      <aside class="side" aria-labelledby="side-title">
        <h2 id="side-title" class="side__title">Et ensuite ?</h2>
        <ol class="next">
          {
            next.map((n, i) => (
              <li>
                <span class="next__num" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3>{n.title}</h3>
                  <p>{n.text}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <RealSiteNote>vos coordonnées, horaires et zone d’intervention.</RealSiteNote>

        <div class="side__media">
          <Picture
            src={pondImg}
            alt="Bassin naturel bordé de pierres et d’iris, avec des nénuphars en fleur."
            formats={['avif', 'webp']}
            widths={[400, 640, 900]}
            sizes="(max-width: 56em) calc(100vw - 2.5rem), 30rem"
          />
        </div>
      </aside>
    </div>
  </section>
</RivageLayout>

<style>
  .contact {
    padding-bottom: clamp(5rem, 10vw, 8rem);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    align-items: start;
    gap: 3rem clamp(2.5rem, 6vw, 6rem);
  }

  /* Formulaire */
  .form {
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
    background: var(--rv-paper);
    border: 1px solid var(--rv-line);
    border-radius: var(--rv-radius);
    box-shadow: 0 30px 60px -45px rgb(20 35 28 / 0.4);
  }

  .form__note {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    margin-bottom: 2rem;
    padding: 0.9rem 1.1rem;
    background: #e6ecdf;
    border: 1px solid rgb(30 51 40 / 0.18);
    border-radius: 4px;
    color: var(--rv-green);
    font-size: 0.9688rem;
    line-height: 1.5;
  }

  .form__note svg {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.05rem;
  }

  .form__note strong {
    font-weight: 650;
  }

  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .form__fields {
    display: grid;
    gap: 1.4rem;
  }

  .form__legend {
    margin-bottom: 0.4rem;
    padding: 0;
    font-family: var(--rv-serif);
    font-size: 1.75rem;
    line-height: 1.2;
    color: var(--rv-green);
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
  }

  .field {
    display: grid;
    gap: 0.45rem;
  }

  label,
  .choices legend {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--rv-ink);
  }

  .optional {
    font-weight: 400;
    color: var(--rv-ink-2);
  }

  input[type='text'],
  input[type='email'],
  input[type='tel'],
  textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    background: #fff;
    border: 1px solid rgb(30 51 40 / 0.25);
    border-radius: 4px;
    font-size: 1rem;
    line-height: 1.4;
  }

  textarea {
    resize: vertical;
    min-height: 9rem;
  }

  textarea::placeholder {
    color: #6b766f;
  }

  input:disabled,
  textarea:disabled {
    background: #f7f4ee;
    border-style: dashed;
    cursor: not-allowed;
  }

  .choices legend {
    margin-bottom: 0.7rem;
    padding: 0;
  }

  .choices__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .choice {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 1rem;
    border: 1px dashed rgb(30 51 40 / 0.3);
    border-radius: 999px;
    font-weight: 500;
    cursor: not-allowed;
  }

  .choice input,
  .consent input {
    width: 1.05rem;
    height: 1.05rem;
    margin: 0;
    accent-color: var(--rv-green);
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-weight: 400;
    font-size: 0.9375rem;
    color: var(--rv-ink-2);
    cursor: not-allowed;
  }

  .consent input {
    flex: none;
    margin-top: 0.2rem;
  }

  .form__submit {
    justify-self: start;
    margin-top: 0.4rem;
  }

  .form__submit:disabled {
    background: #66736b;
    border-color: #66736b;
    color: #fff;
    cursor: not-allowed;
  }

  .form__submit:disabled:hover svg {
    transform: none;
  }

  /* Colonne */
  .side {
    display: grid;
    gap: 2rem;
  }

  .side__title {
    font-size: 2rem;
  }

  .next {
    display: grid;
    gap: 1.4rem;
    padding: 0;
    list-style: none;
  }

  .next li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
  }

  .next__num {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgb(30 51 40 / 0.3);
    border-radius: 50%;
    font-family: var(--rv-serif);
    font-size: 1.0625rem;
    color: var(--rv-green);
  }

  .next h3 {
    margin: 0.2rem 0 0.25rem;
    font-size: 1.3125rem;
  }

  .next p {
    font-size: 0.9688rem;
    color: var(--rv-ink-2);
  }

  .side__media {
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border-radius: var(--rv-radius);
    background: var(--rv-ivory-2);
  }

  .side__media :global(picture) {
    display: block;
    height: 100%;
  }

  .side__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 56em) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 34em) {
    .row {
      grid-template-columns: 1fr;
    }

    .form__submit {
      justify-self: stretch;
      justify-content: center;
    }
  }
</style>
