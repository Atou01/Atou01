---
// Démonstration fictive « Moellon » (maçon, rénovation) — page Contact.
// Formulaire volontairement désactivé (démonstration) : aucun envoi, aucun script.
import { Picture } from 'astro:assets';
import MoellonLayout from '../../../../components/demos/moellon/MoellonLayout.astro';
import RealSiteNote from '../../../../components/demos/moellon/RealSiteNote.astro';
import MIcon from '../../../../components/demos/moellon/MIcon.astro';
import moellon1 from '../../../../assets/photos/moellon-1.jpg';

const prepare = [
  'Quelques photos des murs ou de la pièce concernée',
  'Des plans ou un simple croquis, si vous en avez',
  'La commune du chantier et l’accès au terrain',
  'Vos envies, même encore floues',
];

const next = [
  { title: 'Un premier échange', text: 'pour préciser votre besoin et vos contraintes.' },
  { title: 'Une visite sur place', text: 'pour observer le bâti et en parler ensemble.' },
  { title: 'Un devis détaillé', text: 'poste par poste, avec les solutions expliquées.' },
];
---

<MoellonLayout
  title="Contact — Moellon, démonstration fictive | Atousy"
  description="Contacter Moellon, maçon fictif : page de contact de démonstration réalisée par Atousy. Formulaire désactivé."
  current="contact"
>
  <section class="head" aria-labelledby="page-title">
    <div class="mo-container head__grid">
      <div>
        <p class="mo-kicker">Contact</p>
        <h1 id="page-title">Parlons de votre maison.</h1>
      </div>
      <p class="mo-lead head__lead">
        Rénovation, extension, ouverture ou simple reprise de joints : décrivez-nous votre projet en quelques lignes,
        nous revenons vers vous pour en parler et organiser une visite.
      </p>
    </div>
  </section>

  <section class="body" aria-label="Formulaire et informations de contact">
    <div class="mo-container body__grid">
      <!-- Formulaire (désactivé) -->
      <div class="slab">
        <div class="slab__course" aria-hidden="true"></div>
        <h2 id="form-title" class="slab__title">Votre demande</h2>
        <p id="form-note" class="disabled-note" role="note">
          <MIcon name="lock" class="disabled-note__icon" />
          <span><strong>Formulaire désactivé :</strong> ceci est une démonstration.</span>
        </p>

        <form class="form" aria-labelledby="form-title" aria-describedby="form-note">
          <fieldset class="form__set" disabled>
            <legend class="mo-visually-hidden">Vos coordonnées et votre projet</legend>

            <div class="row">
              <div class="field">
                <label for="mo-name">Nom et prénom</label>
                <input id="mo-name" name="name" type="text" autocomplete="name" disabled />
              </div>
              <div class="field">
                <label for="mo-email">E-mail</label>
                <input id="mo-email" name="email" type="email" autocomplete="email" disabled />
              </div>
            </div>

            <div class="row">
              <div class="field">
                <label for="mo-phone">Téléphone <span class="opt">(facultatif)</span></label>
                <input id="mo-phone" name="phone" type="tel" autocomplete="tel" disabled />
              </div>
              <div class="field">
                <label for="mo-town">Commune du chantier</label>
                <input id="mo-town" name="town" type="text" disabled />
              </div>
            </div>

            <div class="field">
              <label for="mo-type">Type de travaux</label>
              <div class="select">
                <select id="mo-type" name="type" disabled>
                  <option>Rénovation d’une maison ancienne</option>
                  <option>Extension</option>
                  <option>Ouverture dans un mur porteur</option>
                  <option>Murs en pierre, joints à la chaux</option>
                  <option>Dalle ou fondations</option>
                  <option>Autre projet</option>
                </select>
                <MIcon name="chevron" class="select__icon" />
              </div>
            </div>

            <fieldset class="choice" disabled>
              <legend>Votre maison est plutôt…</legend>
              <div class="choice__opts">
                <label class="opt-card">
                  <input type="radio" name="bati" value="pierre" disabled />
                  <span>En pierre</span>
                </label>
                <label class="opt-card">
                  <input type="radio" name="bati" value="blocs" disabled />
                  <span>En blocs ou en brique</span>
                </label>
                <label class="opt-card">
                  <input type="radio" name="bati" value="nsp" disabled />
                  <span>Je ne sais pas</span>
                </label>
              </div>
            </fieldset>

            <div class="field">
              <label for="mo-message">Votre projet en quelques lignes</label>
              <textarea id="mo-message" name="message" rows="6" disabled></textarea>
            </div>

            <div class="field">
              <label for="mo-files">Photos ou plans <span class="opt">(facultatif)</span></label>
              <div class="drop">
                <input id="mo-files" class="drop__input" name="files" type="file" multiple disabled />
                <span class="drop__ui" aria-hidden="true">
                  <MIcon name="upload" class="drop__icon" />
                  <span><strong>Ajouter des fichiers</strong> — photos, plans ou croquis</span>
                </span>
              </div>
            </div>

            <div class="check">
              <input id="mo-consent" name="consent" type="checkbox" disabled />
              <label for="mo-consent">J’accepte que ces informations soient utilisées pour répondre à ma demande.</label>
            </div>

            <button class="mo-btn submit" type="submit" disabled>
              Envoyer la demande <MIcon name="arrow" />
            </button>
          </fieldset>
        </form>
      </div>

      <!-- Informations -->
      <div class="aside">
        <figure class="aside__media">
          <Picture
            src={moellon1}
            alt="Maison ancienne en pierre restaurée, porte et fenêtres gris anthracite, oliviers en pots"
            formats={['avif', 'webp']}
            widths={[480, 720, 960]}
            sizes="(max-width: 60em) 100vw, 34vw"
          />
          <figcaption class="mo-caption">Projet type · Maison en pierre</figcaption>
        </figure>

        <div class="block">
          <h2 class="block__title">Pour préparer notre échange</h2>
          <ul class="ticks">
            {prepare.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="block">
          <h2 class="block__title">Et ensuite ?</h2>
          <ol class="next">
            {
              next.map((n, i) => (
                <li>
                  <span class="next__num" aria-hidden="true">{['I', 'II', 'III'][i]}</span>
                  <span>
                    <strong>{n.title}</strong> {n.text}
                  </span>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="block">
          <h2 class="block__title">Nous joindre</h2>
          <RealSiteNote>votre téléphone, votre e-mail, l’adresse de votre dépôt, vos horaires et votre zone d’intervention, avec un plan d’accès.</RealSiteNote>
        </div>
      </div>
    </div>
  </section>
</MoellonLayout>

<style>
  /* ——— En-tête ——— */
  .head {
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .head__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
    align-items: end;
  }

  .head h1 {
    font-size: clamp(2.9rem, 1.6rem + 4.6vw, 5.9rem);
    font-weight: 360;
    line-height: 0.98;
    letter-spacing: -0.034em;
  }

  .head__lead {
    max-width: 34rem;
    padding-bottom: 0.4rem;
  }

  /* ——— Corps ——— */
  .body {
    padding-bottom: clamp(4.5rem, 9vw, 8rem);
  }

  .body__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: 3rem clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  /* Le formulaire posé comme une dalle de pierre claire, une assise terre cuite en tête */
  .slab {
    position: relative;
    padding: clamp(1.5rem, 4vw, 3rem);
    padding-top: clamp(2.25rem, 4.5vw, 3.5rem);
    background: var(--mo-cream);
    box-shadow: 0 1px 0 var(--mo-line), 0 30px 60px -40px rgb(43 33 26 / 0.45);
  }

  .slab__course {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 0.55rem;
    background:
      linear-gradient(90deg, var(--mo-terra) 0 18%, transparent 18% 19%, var(--mo-terra-ink) 19% 47%, transparent 47% 48%, var(--mo-terra) 48% 63%, transparent 63% 64%, var(--mo-terra-ink) 64% 100%);
  }

  .slab__title {
    font-size: clamp(1.9rem, 1.5rem + 1.2vw, 2.5rem);
  }

  .disabled-note {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding: 0.85rem 1rem;
    background: #f3e2d3;
    border: 1px solid #dfb99c;
    color: var(--mo-ink);
    font-size: 0.975rem;
    line-height: 1.45;
  }

  .disabled-note :global(.disabled-note__icon) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--mo-terra-ink);
  }

  .disabled-note strong {
    font-weight: 700;
  }

  .form {
    margin-top: 2rem;
  }

  .form__set {
    display: grid;
    gap: 1.6rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem 1.5rem;
  }

  .field {
    display: grid;
    gap: 0.35rem;
  }

  label,
  .choice legend {
    font-size: 0.9375rem;
    font-weight: 620;
    color: var(--mo-ink);
  }

  .opt {
    font-weight: 450;
    color: var(--mo-ink-2);
  }

  /* Champs soulignés, façon carnet de chantier */
  input[type='text'],
  input[type='email'],
  input[type='tel'],
  select,
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.15rem;
    background: transparent;
    border: 0;
    border-bottom: 2px solid var(--mo-line-strong);
    border-radius: 0;
    color: var(--mo-ink);
    font-size: 1rem;
    line-height: 1.4;
  }

  textarea {
    min-height: 8.5rem;
    padding: 0.8rem 0.9rem;
    resize: vertical;
    background: var(--mo-paper);
    border: 1px solid var(--mo-line-strong);
    border-bottom-width: 2px;
  }

  .select {
    position: relative;
  }

  select {
    appearance: none;
    padding-right: 2.25rem;
  }

  .select :global(.select__icon) {
    position: absolute;
    right: 0.25rem;
    top: 50%;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: -0.575rem;
    color: var(--mo-ink-2);
    pointer-events: none;
  }

  .choice {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .choice legend {
    padding: 0;
    margin-bottom: 0.7rem;
  }

  .choice__opts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .opt-card {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.9rem;
    padding: 0.5rem 1rem 0.5rem 0.8rem;
    background: var(--mo-paper);
    border: 1px solid var(--mo-line-strong);
    font-weight: 500;
    cursor: not-allowed;
  }

  .opt-card input {
    width: 1.05rem;
    height: 1.05rem;
    margin: 0;
    accent-color: var(--mo-terra);
  }

  .drop {
    position: relative;
    background: var(--mo-paper);
    border: 1px dashed var(--mo-line-strong);
  }

  .drop__input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: not-allowed;
  }

  .drop__ui {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 0.95rem;
    color: var(--mo-ink-2);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .drop__ui :global(.drop__icon) {
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    color: var(--mo-terra-ink);
  }

  .drop__ui strong {
    font-weight: 650;
    color: var(--mo-ink);
  }

  .form__set:disabled input,
  .form__set:disabled select,
  .form__set:disabled textarea {
    cursor: not-allowed;
    opacity: 1;
  }

  /* Le champ fichier natif reste invisible sous son habillage en français */
  .form__set:disabled .drop__input {
    opacity: 0;
  }

  .check {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  /* Case de 24 px : cible tactile confortable, alignée sur la première ligne du libellé */
  .check input {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin: 0;
    accent-color: var(--mo-terra);
  }

  .check label {
    font-weight: 450;
    color: var(--mo-ink-2);
  }

  .submit {
    justify-self: start;
    margin-top: 0.25rem;
  }

  .submit:disabled {
    cursor: not-allowed;
    background: #75655a;
    border-color: #75655a;
    color: var(--mo-cream);
    box-shadow: none;
  }

  /* ——— Informations ——— */
  .aside {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3rem);
  }

  .aside__media {
    display: grid;
    gap: 0.8rem;
  }

  .aside__media :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: 65% 50%;
  }

  .block__title {
    margin-bottom: 1.1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--mo-line-strong);
    font-family: var(--mo-sans);
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.15em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .ticks {
    display: grid;
    gap: 0.65rem;
    padding: 0;
    list-style: none;
  }

  .ticks li {
    position: relative;
    padding-left: 1.6rem;
  }

  .ticks li::before {
    content: '';
    position: absolute;
    left: 0.05rem;
    top: 0.62em;
    width: 0.8rem;
    height: 0.4rem;
    border-radius: 1px 2px 1px 2px;
    background: var(--mo-terra);
  }

  .next {
    display: grid;
    gap: 0.9rem;
    padding: 0;
    list-style: none;
  }

  .next li {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 0.5rem;
    color: var(--mo-ink-2);
  }

  .next strong {
    font-weight: 650;
    color: var(--mo-ink);
  }

  .next__num {
    font-family: var(--mo-serif);
    font-size: 1.4rem;
    line-height: 1.1;
    color: var(--mo-terra-ink);
  }

  /* ——— Responsive ——— */
  @media (max-width: 60em) {
    .head__grid,
    .body__grid {
      grid-template-columns: 1fr;
    }

    .aside__media {
      display: none;
    }
  }

  @media (max-width: 36em) {
    .row {
      grid-template-columns: 1fr;
    }

    .slab {
      margin-inline: calc(-1 * var(--mo-gutter) / 2);
    }

    .submit {
      justify-self: stretch;
      justify-content: center;
    }
  }
</style>
