---
// Démonstration fictive « Moellon » (maçon, rénovation) — page Notre approche.
// Déroulé générique d'un projet : aucune durée, aucun prix, aucune garantie chiffrée.
import { Picture } from 'astro:assets';
import MoellonLayout from '../../../../components/demos/moellon/MoellonLayout.astro';
import PageHead from '../../../../components/demos/moellon/PageHead.astro';
import ContactBand from '../../../../components/demos/moellon/ContactBand.astro';
import RealSiteNote from '../../../../components/demos/moellon/RealSiteNote.astro';
import MIcon from '../../../../components/demos/moellon/MIcon.astro';
import moellon3 from '../../../../assets/photos/moellon-3.jpg';
import moellon6 from '../../../../assets/photos/moellon-6.jpg';

const steps = [
  {
    title: 'Le premier échange',
    text: 'Vous nous décrivez votre projet, avec quelques photos si possible. Nous vous disons franchement si nous sommes les bons interlocuteurs pour ce chantier.',
    out: 'Un premier avis et, si le projet nous correspond, un rendez-vous sur place.',
  },
  {
    title: 'La visite et le diagnostic',
    text: 'Sur place, nous observons les murs, les appuis, les fissures ou les traces d’humidité, et nous écoutons vos usages. C’est le moment de poser toutes vos questions.',
    out: 'Un constat partagé sur l’état du bâti.',
  },
  {
    title: 'L’étude et le devis',
    text: 'Nous proposons une solution technique expliquée, les matériaux envisagés et, si nécessaire, l’intervention d’un bureau d’études. Le devis est détaillé poste par poste.',
    out: 'Un devis lisible, sans ligne fourre-tout.',
  },
  {
    title: 'La préparation',
    text: 'Démarches éventuelles, commande des matériaux, organisation des accès et de la protection des lieux : tout est calé avec vous avant le premier coup de truelle.',
    out: 'Un planning partagé et des interlocuteurs identifiés.',
  },
  {
    title: 'Le chantier',
    text: 'Pièces protégées, chantier rangé en fin de journée, points réguliers sur l’avancement : vous savez où en sont les travaux, et pourquoi.',
    out: 'Un même interlocuteur du début à la fin.',
  },
  {
    title: 'La réception',
    text: 'Nous faisons le tour des travaux ensemble, nous reprenons les éventuelles réserves et nous vous laissons des conseils d’entretien adaptés à vos murs.',
    out: 'Des conseils pour faire durer l’ouvrage.',
  },
];

const numerals = ['I', 'II', 'III', 'IV', 'V', 'VI'];

const principles = [
  { title: 'Respecter le bâti', text: 'Comprendre comment la maison a été construite avant de la modifier, et garder ce qui peut l’être.' },
  { title: 'Expliquer avant d’agir', text: 'Chaque choix technique est présenté et justifié, pour que vous décidiez en connaissance de cause.' },
  { title: 'Des matériaux compatibles', text: 'La chaux sur la pierre, le béton là où il est utile : chaque matériau à sa juste place.' },
  { title: 'Un chantier tenu', text: 'Des abords protégés, un chantier rangé, des voisins respectés : la maison reste habitable autant que possible.' },
];

const faq = [
  {
    q: 'Intervenez-vous aussi sur de petits travaux ?',
    a: 'Une reprise de joints ou un muret à remonter méritent la même attention qu’une extension. Décrivez-nous votre besoin : nous vous dirons s’il entre dans notre activité.',
  },
  {
    q: 'Faut-il une autorisation pour ouvrir un mur ?',
    a: 'Une modification de façade demande en général une déclaration préalable auprès de la mairie ; à l’intérieur, la question est surtout structurelle. Dans tous les cas, nous en parlons dès la visite.',
  },
  {
    q: 'Pourquoi la chaux plutôt que le ciment sur un mur ancien ?',
    a: 'Un mur ancien en pierre doit laisser passer la vapeur d’eau. La chaux, souple et perméable, l’accompagne ; un mortier de ciment peut au contraire piéger l’humidité et abîmer la pierre.',
  },
  {
    q: 'Combien coûte un chantier de rénovation ?',
    a: 'Tout dépend de l’état du bâti, de l’accès et de l’ampleur des travaux. C’est pour cela que chaque devis suit une visite sur place, et qu’il détaille chaque poste.',
  },
];
---

<MoellonLayout
  title="Notre approche — Moellon, démonstration fictive | Atousy"
  description="L’approche de Moellon, maçon fictif : du premier échange à la réception des travaux, les étapes d’un chantier de rénovation ou de maçonnerie. Démonstration Atousy."
  current="approche"
>
  <PageHead
    kicker="Notre approche"
    title="Un bon chantier se prépare avant de commencer."
    lead="Chaque maison est différente, mais notre façon de travailler reste la même : écouter, comprendre le bâti, expliquer, puis réaliser avec soin. Voici comment se déroule un projet, étape par étape."
    image={moellon3}
    alt="Mur ancien en moellons calcaires aux joints de chaux, en lumière rasante de fin de journée"
    caption="Comprendre le mur avant d’intervenir"
    focus="50% 55%"
  />

  <!-- Le déroulé -->
  <section class="mo-section flow" aria-labelledby="flow-title">
    <div class="mo-container flow__grid">
      <div class="flow__intro">
        <p class="mo-kicker">Le déroulé</p>
        <h2 id="flow-title" class="mo-h2">Six étapes, un seul interlocuteur.</h2>
        <p class="mo-lead">Pas de surprise ni de jargon : à chaque étape, vous savez ce qui se passe et ce que vous recevez.</p>
      </div>
      <ol class="flow__list">
        {
          steps.map((s, i) => (
            <li class="stage">
              <span class="stage__num" aria-hidden="true">{numerals[i]}</span>
              <div class="stage__body">
                <h3 class="stage__title">
                  <span class="mo-visually-hidden">Étape {i + 1} : </span>
                  {s.title}
                </h3>
                <p class="stage__text">{s.text}</p>
                <p class="stage__out">
                  <MIcon name="check" class="stage__icon" />
                  <span>{s.out}</span>
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Nos principes -->
  <section class="mo-section principles mo-dark" aria-labelledby="principles-title">
    <div class="principles__grid">
      <figure class="principles__media">
        <Picture
          src={moellon6}
          alt="Intérieur rénové lumineux : mur en pierre apparente, baie vitrée sur le jardin, fauteuil en lin et poutre ancienne"
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 56em) 100vw, 50vw"
        />
      </figure>
      <div class="principles__body">
        <p class="mo-kicker">Nos principes</p>
        <h2 id="principles-title" class="mo-h2">Ce qui guide chaque chantier.</h2>
        <ul class="principles__list">
          {
            principles.map((p) => (
              <li>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ul>
        <RealSiteNote tone="dark">vos qualifications, vos assurances et vos garanties, avec les justificatifs correspondants.</RealSiteNote>
      </div>
    </div>
  </section>

  <!-- Questions fréquentes -->
  <section class="mo-section faq" aria-labelledby="faq-title">
    <div class="mo-container faq__grid">
      <div>
        <p class="mo-kicker">Questions fréquentes</p>
        <h2 id="faq-title" class="mo-h2">Ce que l’on nous demande souvent.</h2>
        <a class="mo-link faq__link" href="/exemples/moellon/contact/">Poser une autre question <MIcon name="arrow" /></a>
      </div>
      <div class="faq__list">
        {
          faq.map((f) => (
            <details class="qa">
              <summary>
                <span>{f.q}</span>
                <span class="qa__sign" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <ContactBand />
</MoellonLayout>

<style>
  /* ——— Le déroulé ——— */
  .flow__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.25fr);
    gap: 3rem clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .flow__intro {
    position: sticky;
    top: 8rem;
  }

  .flow__intro .mo-lead {
    margin-top: 1.25rem;
  }

  .flow__list {
    position: relative;
    padding: 0;
    list-style: none;
  }

  /* Un lit de mortier vertical relie les étapes */
  .flow__list::before {
    content: '';
    position: absolute;
    left: 2.25rem;
    top: 1rem;
    bottom: 1rem;
    width: 2px;
    background: repeating-linear-gradient(180deg, var(--mo-line-strong) 0 10px, transparent 10px 16px);
  }

  .stage {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-bottom: clamp(2.25rem, 4vw, 3.25rem);
  }

  .stage:last-child {
    padding-bottom: 0;
  }

  .stage__num {
    position: relative;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 3.25rem;
    background-color: var(--mo-paper);
    border: 1px solid var(--mo-line-strong);
    border-radius: 3px 5px 3px 6px;
    font-family: var(--mo-serif);
    font-size: 1.45rem;
    font-weight: 450;
    color: var(--mo-terra-ink);
  }

  .stage:nth-child(odd) .stage__num {
    background: var(--mo-terra);
    border-color: var(--mo-terra);
    color: var(--mo-cream);
  }

  .stage__body {
    padding-top: 0.45rem;
  }

  .stage__title {
    font-size: clamp(1.55rem, 1.25rem + 0.9vw, 2.1rem);
    font-weight: 420;
  }

  .stage__text {
    margin-top: 0.6rem;
    color: var(--mo-ink-2);
  }

  .stage__out {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 1rem;
    padding: 0.7rem 0.9rem;
    background: rgb(250 246 239 / 0.6);
    border: 1px solid var(--mo-line);
    font-size: 0.95rem;
    font-weight: 560;
  }

  .stage__out :global(.stage__icon) {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.15rem;
    color: var(--mo-terra-ink);
  }

  /* ——— Nos principes ——— */
  .principles__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem clamp(2.5rem, 7vw, 7rem);
    align-items: center;
    padding-right: max(var(--mo-gutter), (100% - var(--mo-max)) / 2);
  }

  .principles__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 55% 50%;
  }

  .principles__body {
    max-width: 38rem;
  }

  .principles__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 2.25rem;
    margin: clamp(2rem, 4vw, 3rem) 0;
    padding: 0;
    list-style: none;
  }

  .principles__list li {
    padding-top: 1.1rem;
    border-top: 2px solid var(--mo-ochre-light);
  }

  .principles__list h3 {
    font-size: 1.4rem;
    font-weight: 450;
  }

  .principles__list p {
    margin-top: 0.5rem;
    font-size: 0.975rem;
    color: var(--mo-lime-dim);
  }

  /* ——— Questions fréquentes ——— */
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 2.5rem clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .faq__link {
    margin-top: 1.75rem;
  }

  .faq__list {
    border-top: 1px solid var(--mo-line-strong);
  }

  .qa {
    border-bottom: 1px solid var(--mo-line-strong);
  }

  .qa summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.35rem;
    font-family: var(--mo-serif);
    font-size: clamp(1.3rem, 1.15rem + 0.5vw, 1.6rem);
    font-weight: 430;
    line-height: 1.25;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }

  .qa summary::-webkit-details-marker {
    display: none;
  }

  .qa summary:hover {
    color: var(--mo-terra-ink);
  }

  .qa summary:focus-visible {
    outline-offset: 2px;
  }

  .qa__sign {
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--mo-line-strong);
    border-radius: 2px;
  }

  .qa__sign::before,
  .qa__sign::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.9rem;
    height: 2px;
    margin: -1px 0 0 -0.45rem;
    background: var(--mo-terra-ink);
    transition: transform 0.25s var(--mo-ease);
  }

  .qa__sign::after {
    transform: rotate(90deg);
  }

  .qa[open] .qa__sign::after {
    transform: rotate(0deg);
  }

  .qa p {
    max-width: 58ch;
    padding-bottom: 1.5rem;
    color: var(--mo-ink-2);
  }

  /* ——— Responsive ——— */
  @media (max-width: 56em) {
    .flow__grid,
    .faq__grid {
      grid-template-columns: 1fr;
    }

    .flow__intro {
      position: static;
    }

    .principles__grid {
      grid-template-columns: 1fr;
      padding-right: 0;
    }

    .principles__media :global(img) {
      aspect-ratio: 3 / 2;
    }

    .principles__body {
      max-width: none;
      padding-inline: var(--mo-gutter);
    }
  }

  @media (max-width: 36em) {
    .principles__list {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .flow__list::before {
      left: 1.6rem;
    }

    .stage {
      grid-template-columns: 3.25rem minmax(0, 1fr);
      gap: 1rem;
    }

    .stage__num {
      width: 3.25rem;
      height: 2.6rem;
      font-size: 1.2rem;
    }

    .stage__body {
      padding-top: 0.2rem;
    }
  }
</style>
