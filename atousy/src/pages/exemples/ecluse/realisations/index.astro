---
// Démonstration fictive « Écluse » (plombier-chauffagiste) — page Réalisations (projets types).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import EcluseLayout from '../../../../components/demos/ecluse/EcluseLayout.astro';
import PageHead from '../../../../components/demos/ecluse/PageHead.astro';
import Jump from '../../../../components/demos/ecluse/Jump.astro';
import RealSiteNote from '../../../../components/demos/ecluse/RealSiteNote.astro';
import ContactBand from '../../../../components/demos/ecluse/ContactBand.astro';
import ecluse1 from '../../../../assets/photos/ecluse-1.jpg';
import ecluse2 from '../../../../assets/photos/ecluse-2.jpg';
import ecluse3 from '../../../../assets/photos/ecluse-3.jpg';
import ecluse5 from '../../../../assets/photos/ecluse-5.jpg';
import ecluse6 from '../../../../assets/photos/ecluse-6.jpg';

interface Project {
  id: string;
  type: string;
  short: string;
  title: string;
  need: string;
  work: string;
  result: string;
  tags: string[];
  image: ImageMetadata;
  alt: string;
  position: string;
}

const projects: Project[] = [
  {
    id: 'salle-de-bain',
    type: 'Salle de bain',
    short: 'Salle de bain',
    title: 'Une douche à l’italienne à la place de la baignoire',
    need: 'Une baignoire peu utilisée, une pièce sombre et difficile à entretenir.',
    work: 'Reprise des évacuations, receveur extra-plat encastré, paroi vitrée, robinetterie noire mate et meuble vasque suspendu.',
    result: 'Une pièce lumineuse, une douche de plain-pied et un entretien simplifié.',
    tags: ['Plomberie', 'Évacuations', 'Pose d’équipements'],
    image: ecluse1,
    alt: 'Salle de bain rénovée : douche à l’italienne vitrée, robinetterie noire mate, meuble vasque gris-bleu et grande fenêtre',
    position: '55% 50%',
  },
  {
    id: 'pompe-a-chaleur',
    type: 'Pompe à chaleur',
    short: 'Pompe à chaleur',
    title: 'Une pompe à chaleur à la place d’une chaudière ancienne',
    need: 'Une chaudière en fin de course et l’envie de changer de mode de chauffage.',
    work: 'Étude du logement et des radiateurs existants, pose d’une unité extérieure sur socle, raccordement au circuit de chauffage.',
    result: 'Un chauffage repensé, et une mise en service expliquée pas à pas aux occupants.',
    tags: ['Étude', 'Pompe à chaleur air-eau', 'Mise en service'],
    image: ecluse2,
    alt: 'Unité extérieure de pompe à chaleur posée sur un socle en béton, le long d’une maison aux murs clairs',
    position: '62% 50%',
  },
  {
    id: 'local-technique',
    type: 'Chauffage',
    short: 'Local technique',
    title: 'Un local technique remis à plat',
    need: 'Une chaudière et un ballon raccordés au fil des années, sans vue d’ensemble.',
    work: 'Nouvelle chaudière murale, ballon d’eau chaude, tuyauteries reprises en cuivre et vannes repérées.',
    result: 'Une installation lisible, plus simple à entretenir et à dépanner.',
    tags: ['Chaudière', 'Eau chaude', 'Tuyauterie cuivre'],
    image: ecluse5,
    alt: 'Local technique clair avec chaudière murale, ballon d’eau chaude blanc et réseau de tuyaux en cuivre',
    position: '50% 50%',
  },
  {
    id: 'cuisine',
    type: 'Cuisine',
    short: 'Cuisine',
    title: 'Une cuisine raccordée de l’arrivée d’eau à l’évacuation',
    need: 'Une rénovation de cuisine, avec un évier déplacé sous la fenêtre.',
    work: 'Déplacement des arrivées et de l’évacuation, raccordement de l’évier, du mitigeur et du lave-vaisselle, en lien avec le cuisiniste.',
    result: 'Des raccordements propres et accessibles derrière les meubles.',
    tags: ['Plomberie', 'Raccordements', 'Coordination'],
    image: ecluse6,
    alt: 'Cuisine aux façades en chêne clair, plan de travail en pierre, évier inox et mitigeur sous une fenêtre',
    position: '40% 50%',
  },
  {
    id: 'distribution',
    type: 'Plomberie',
    short: 'Distribution d’eau',
    title: 'Une distribution d’eau reprise en cuivre',
    need: 'Des canalisations anciennes et une pression qui varie d’une pièce à l’autre.',
    work: 'Nouveau collecteur en laiton, départs en cuivre vers chaque pièce et vannes d’isolement individuelles.',
    result: 'Chaque circuit peut être coupé séparément, sans priver toute la maison d’eau.',
    tags: ['Collecteur', 'Cuivre', 'Vannes d’isolement'],
    image: ecluse3,
    alt: 'Tuyaux en cuivre reliés à un collecteur en laiton muni de vannes à poignée noire',
    position: '50% 50%',
  },
];
---

<EcluseLayout
  title="Réalisations — Écluse, démonstration fictive | Atousy"
  description="Réalisations d’Écluse, plombier-chauffagiste fictif : projets types de salle de bain, pompe à chaleur, chauffage et plomberie. Démonstration réalisée par Atousy."
  current="realisations"
>
  <PageHead
    crumb="Réalisations"
    title="Des chantiers, expliqués."
    lead="Quelques projets types pour illustrer notre façon de travailler : le besoin de départ, ce que nous avons fait, et ce que cela change au quotidien."
  >
    <Jump items={projects.map((p) => ({ href: `#${p.id}`, label: p.short }))} label="Projets présentés" />
    <Fragment slot="aside">
      <div class="reading">
        <p class="reading__title">Chaque projet en trois temps</p>
        <ol class="reading__steps">
          <li><strong>Le besoin</strong> ce qui motivait les travaux</li>
          <li><strong>Notre intervention</strong> ce que nous avons proposé et réalisé</li>
          <li><strong>Le résultat</strong> ce que cela change au quotidien</li>
        </ol>
        <RealSiteNote>
          vos vraies réalisations, avec des photos avant/après prises sur vos chantiers et l’accord de vos clients.
        </RealSiteNote>
      </div>
    </Fragment>
  </PageHead>

  <section class="projects" aria-label="Projets types">
    <div class="ec-container">
      {
        projects.map((p, i) => (
          <article id={p.id} class:list={['project', i === 0 && 'project--lead', i % 2 === 1 && 'project--flip']} aria-labelledby={`${p.id}-title`}>
            <div class="project__media">
              <Picture
                src={p.image}
                alt={p.alt}
                formats={['avif', 'webp']}
                widths={i === 0 ? [640, 960, 1280, 1600, 2000] : [560, 800, 1100, 1400]}
                sizes={i === 0 ? '(max-width: 80em) calc(100vw - 2rem), 80rem' : '(max-width: 60em) calc(100vw - 2rem), 46vw'}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                style={`object-position: ${p.position}`}
              />
            </div>
            <div class="project__body">
              <p class="ec-caption">Projet type · {p.type}</p>
              <h2 id={`${p.id}-title`} class="project__title">
                {p.title}
              </h2>
              <dl class="facts">
                <div>
                  <dt>Le besoin</dt>
                  <dd>{p.need}</dd>
                </div>
                <div>
                  <dt>Notre intervention</dt>
                  <dd>{p.work}</dd>
                </div>
                <div>
                  <dt>Le résultat</dt>
                  <dd>{p.result}</dd>
                </div>
              </dl>
              <ul class="tags" aria-label="Travaux réalisés">
                {p.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <ContactBand
    title="Un projet qui ressemble à l’un de ceux-ci ?"
    text="Parlez-nous de votre logement et de ce que vous aimeriez changer : nous venons voir sur place avant de vous proposer quoi que ce soit."
    button="Parler de votre projet"
  />
</EcluseLayout>

<style>
  /* ——— Encart de lecture (en-tête) ——— */
  .reading {
    display: grid;
    gap: 1.25rem;
    max-width: 32rem;
    margin-left: auto;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--ec-white);
    border: 1px solid var(--ec-line);
    border-radius: var(--ec-radius);
  }

  .reading__title {
    color: var(--ec-ink);
    font-size: 1.125rem;
    font-weight: 750;
    letter-spacing: -0.02em;
  }

  .reading__steps {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: reading;
  }

  .reading__steps li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    column-gap: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.45;
    counter-increment: reading;
  }

  .reading__steps li::before {
    content: counter(reading);
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 2px solid var(--ec-brass);
    color: var(--ec-ink);
    font-size: 0.875rem;
    font-weight: 800;
  }

  .reading__steps strong {
    display: block;
    color: var(--ec-ink);
    font-weight: 700;
  }

  .projects {
    padding-block: clamp(3rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem);
  }

  .projects .ec-container {
    display: grid;
    gap: clamp(3.5rem, 8vw, 6.5rem);
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 2rem clamp(2rem, 6vw, 5.5rem);
    align-items: center;
  }

  .project--flip .project__media {
    order: 2;
  }

  .project__media {
    overflow: hidden;
    border-radius: var(--ec-radius-lg);
    background: var(--ec-mist);
  }

  .project__media :global(img) {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
  }

  .project__title {
    max-width: 22ch;
    margin-top: 0.75rem;
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.038em;
  }

  .facts {
    display: grid;
    gap: 1.1rem;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
  }

  .facts div {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 0.25rem 1.25rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--ec-line);
  }

  .facts dt {
    color: var(--ec-ink);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .facts dd {
    margin: 0;
    font-size: 0.9844rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.3rem 0.75rem;
    background: var(--ec-mist);
    border: 1px solid var(--ec-line);
    border-radius: 999px;
    color: var(--ec-slate);
    font-size: 0.8438rem;
    font-weight: 600;
  }

  /* Premier projet : grande image, texte en panneau */
  .project--lead {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .project--lead .project__media :global(img) {
    aspect-ratio: 21 / 9;
  }

  .project--lead .project__body {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 0 clamp(2rem, 5vw, 4.5rem);
    width: min(100% - 2 * clamp(1rem, 4vw, 3rem), 68rem);
    margin: clamp(-6rem, -8vw, -3rem) auto 0;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--ec-white);
    border: 1px solid var(--ec-line);
    border-radius: var(--ec-radius-lg);
    box-shadow: var(--ec-shadow);
  }

  .project--lead .ec-caption,
  .project--lead .project__title {
    grid-column: 1;
  }

  .project--lead .facts {
    grid-column: 2;
    grid-row: 1 / span 3;
    margin-top: 0;
  }

  .project--lead .facts div:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .project--lead .tags {
    grid-column: 1;
  }

  @media (max-width: 60em) {
    .reading {
      max-width: none;
      margin-left: 0;
    }

    .project,
    .project--lead .project__body {
      grid-template-columns: 1fr;
    }

    .project--flip .project__media {
      order: 0;
    }

    .project--lead .project__media :global(img) {
      aspect-ratio: 4 / 3;
    }

    .project--lead .project__body {
      width: auto;
      margin: 0;
      padding: 1.5rem 0 0;
      background: none;
      border: 0;
      box-shadow: none;
    }

    .project--lead .facts,
    .project--lead .tags {
      grid-column: auto;
      grid-row: auto;
    }

    .project--lead .facts {
      margin-top: 1.5rem;
    }

    .project--lead .facts div:first-child {
      padding-top: 1.1rem;
      border-top: 1px solid var(--ec-line);
    }
  }

  /* Tablette : photos plus panoramiques */
  @media (min-width: 40.01em) and (max-width: 60em) {
    .project__media :global(img),
    .project--lead .project__media :global(img) {
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 36em) {
    .facts div {
      grid-template-columns: 1fr;
    }
  }
</style>
