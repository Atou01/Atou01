---
// Démonstration fictive « Faîtage » (charpentier) — page Contact.
// Formulaire volontairement désactivé (démonstration) : aucun envoi, aucun script.
import FaitageLayout from '../../../../components/demos/faitage/FaitageLayout.astro';
import RealSiteNote from '../../../../components/demos/faitage/RealSiteNote.astro';
import Icon from '../../../../components/Icon.astro';

const prepare = [
  'Quelques photos du bâtiment ou du terrain',
  'Des plans ou un croquis, si vous en avez',
  'La commune du chantier et vos délais souhaités',
  'Un ordre d’idée de votre budget, même approximatif',
];

const next = [
  { title: 'Un premier échange', text: 'Nous vous recontactons pour préciser votre besoin.' },
  { title: 'Une visite sur place', text: 'Relevé, contraintes du site, premières pistes.' },
  { title: 'Un devis détaillé', text: 'Poste par poste, accompagné d’un planning.' },
];
---

<FaitageLayout
  title="Contact — Faîtage, démonstration fictive | Atousy"
  description="Contacter Faîtage, charpentier fictif : page de contact de démonstration réalisée par Atousy. Formulaire désactivé."
  current="contact"
>
  <!-- En-tête de page -->
  <section class="head" aria-labelledby="page-title">
    <div class="ft-container head__grid">
      <div>
        <p class="ft-label">Contact</p>
        <h1 id="page-title">Parlons de votre projet.</h1>
      </div>
      <p class="ft-lead head__lead">
        Charpente neuve, maison bois, extension ou rénovation : décrivez-nous votre projet, nous revenons vers vous pour
        en discuter et organiser une visite.
      </p>
    </div>
  </section>

  <section class="ft-section body" aria-label="Formulaire et informations de contact">
    <div class="ft-container body__grid">
      <!-- Formulaire (désactivé) -->
      <div class="card">
        <h2 id="form-title" class="card__title">Votre demande</h2>
        <p id="form-note" class="disabled-note" role="note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="5" y="10.5" width="14" height="10" rx="1.5" />
            <path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3" />
          </svg>
          <span><strong>Formulaire désactivé :</strong> ceci est une démonstration.</span>
        </p>

        <form class="form" aria-labelledby="form-title" aria-describedby="form-note">
          <fieldset disabled>
            <legend class="ft-visually-hidden">Vos coordonnées et votre projet</legend>
            <div class="row">
              <div class="field">
                <label for="ft-name">Nom et prénom</label>
                <input id="ft-name" name="name" type="text" autocomplete="name" disabled />
              </div>
              <div class="field">
                <label for="ft-email">E-mail</label>
                <input id="ft-email" name="email" type="email" autocomplete="email" disabled />
              </div>
            </div>
            <div class="row">
              <div class="field">
                <label for="ft-phone">Téléphone <span class="opt">(facultatif)</span></label>
                <input id="ft-phone" name="phone" type="tel" autocomplete="tel" disabled />
              </div>
              <div class="field">
                <label for="ft-town">Commune du chantier</label>
                <input id="ft-town" name="town" type="text" disabled />
              </div>
            </div>
            <div class="row">
              <div class="field">
                <label for="ft-type">Type de projet</label>
                <div class="select">
                  <select id="ft-type" name="type" disabled>
                    <option>Charpente neuve</option>
                    <option>Maison ossature bois</option>
                    <option>Extension ou surélévation</option>
                    <option>Rénovation de charpente</option>
                    <option>Couverture</option>
                    <option>Préau, auvent, terrasse couverte</option>
                    <option>Autre projet</option>
                  </select>
                  <Icon name="chevron" class="select__icon" />
                </div>
              </div>
              <div class="field">
                <label for="ft-when">Échéance souhaitée</label>
                <div class="select">
                  <select id="ft-when" name="when" disabled>
                    <option>Pas encore définie</option>
                    <option>Dès que possible</option>
                    <option>Dans l’année</option>
                    <option>L’année prochaine</option>
                  </select>
                  <Icon name="chevron" class="select__icon" />
                </div>
              </div>
            </div>
            <div class="field">
              <label for="ft-message">Votre projet en quelques lignes</label>
              <textarea id="ft-message" name="message" rows="6" disabled></textarea>
            </div>
            <div class="field">
              <label for="ft-files">Photos ou plans <span class="opt">(facultatif)</span></label>
              <input id="ft-files" name="files" type="file" multiple disabled />
            </div>
            <div class="check">
              <input id="ft-consent" name="consent" type="checkbox" disabled />
              <label for="ft-consent">J’accepte que ces informations soient utilisées pour répondre à ma demande.</label>
            </div>
            <button class="ft-btn submit" type="submit" disabled>
              Envoyer la demande <Icon name="arrow" />
            </button>
          </fieldset>
        </form>
      </div>

      <!-- Informations -->
      <aside class="aside" aria-label="Préparer votre demande">
        <div class="block">
          <h2 class="block__title">Pour préparer notre échange</h2>
          <ul class="ticks">
            {prepare.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="block">
          <h2 class="block__title">Et ensuite ?</h2>
          <ol class="next">
            {
              next.map((n, i) => (
                <li>
                  <span class="next__num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span>
                    <strong>{n.title}</strong>
                    {n.text}
                  </span>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="block">
          <h2 class="block__title">Nous trouver</h2>
          <RealSiteNote>vos coordonnées (téléphone, e-mail, adresse de l’atelier), vos horaires et votre zone d’intervention, avec un plan d’accès.</RealSiteNote>
        </div>
      </aside>
    </div>
  </section>
</FaitageLayout>

<style>
  /* ——— En-tête ——— */
  .head {
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(2.5rem, 5vw, 4rem);
    background: var(--ft-white);
    border-bottom: 1px solid var(--ft-line);
  }

  .head__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
    align-items: end;
  }

  .head h1 {
    font-size: clamp(2.9rem, 1.7rem + 4.2vw, 5.6rem);
    font-weight: 420;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .head__lead {
    max-width: 34rem;
  }

  /* ——— Corps ——— */
  .body {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .body__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 3rem clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .card {
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--ft-white);
    border: 1px solid var(--ft-line);
    border-top: 3px solid var(--ft-charcoal);
  }

  .card__title {
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem);
  }

  .disabled-note {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding: 0.85rem 1rem;
    background: #f6ead9;
    border: 1px solid #e3c9a5;
    color: var(--ft-ink);
    font-size: 0.9688rem;
    line-height: 1.45;
  }

  .disabled-note svg {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--ft-wood-ink);
  }

  .disabled-note strong {
    font-weight: 700;
  }

  .form {
    margin-top: 1.75rem;
  }

  fieldset {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .field {
    display: grid;
    gap: 0.45rem;
  }

  label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ft-ink);
  }

  .opt {
    font-weight: 450;
    color: var(--ft-ink-2);
  }

  input[type='text'],
  input[type='email'],
  input[type='tel'],
  select,
  textarea {
    width: 100%;
    min-height: 3.1rem;
    padding: 0.75rem 0.9rem;
    background: var(--ft-paper);
    border: 1px solid var(--ft-line-strong);
    border-radius: 2px;
    color: var(--ft-ink);
    font-size: 1rem;
    line-height: 1.4;
  }

  textarea {
    resize: vertical;
    min-height: 9rem;
  }

  input[type='file'] {
    width: 100%;
    padding: 0.75rem 0.9rem;
    background: var(--ft-paper);
    border: 1px dashed var(--ft-line-strong);
    border-radius: 2px;
    color: var(--ft-ink-2);
    font-size: 0.9375rem;
  }

  input[type='file']::file-selector-button {
    margin-right: 0.9rem;
    padding: 0.45rem 0.85rem;
    background: var(--ft-white);
    border: 1px solid var(--ft-line-strong);
    border-radius: 2px;
    color: var(--ft-ink);
    font: inherit;
    font-weight: 600;
  }

  .select {
    position: relative;
  }

  select {
    appearance: none;
    padding-right: 2.5rem;
  }

  .select :global(.select__icon) {
    position: absolute;
    right: 0.9rem;
    top: 50%;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: -0.55rem;
    color: var(--ft-ink-2);
    pointer-events: none;
  }

  fieldset:disabled input,
  fieldset:disabled select,
  fieldset:disabled textarea {
    cursor: not-allowed;
    opacity: 1;
    background-image: repeating-linear-gradient(-45deg, transparent 0 10px, rgb(43 34 25 / 0.025) 10px 20px);
  }

  .check {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .check input {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin: 0.2rem 0 0;
    accent-color: var(--ft-charcoal);
  }

  .check label {
    font-weight: 450;
    color: var(--ft-ink-2);
  }

  .submit {
    justify-self: start;
    margin-top: 0.5rem;
  }

  .submit:disabled {
    cursor: not-allowed;
    background: #6d645b;
    border-color: #6d645b;
    color: var(--ft-white);
  }

  /* ——— Informations ——— */
  .aside {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3rem);
  }

  .block__title {
    margin-bottom: 1.1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--ft-line-strong);
    font-family: var(--ft-sans);
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .ticks {
    display: grid;
    gap: 0.7rem;
    padding: 0;
    list-style: none;
  }

  .ticks li {
    position: relative;
    padding-left: 1.5rem;
  }

  .ticks li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.65em;
    width: 0.5rem;
    height: 0.5rem;
    border-top: 2px solid var(--ft-wood);
    border-left: 2px solid var(--ft-wood);
    transform: rotate(45deg);
  }

  .next {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .next li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.5rem;
    color: var(--ft-ink-2);
  }

  .next strong {
    display: block;
    font-weight: 650;
    color: var(--ft-ink);
  }

  .next__num {
    font-family: var(--ft-serif);
    font-size: 1.5rem;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--ft-wood-ink);
  }

  /* ——— Responsive ——— */
  @media (max-width: 60em) {
    .head__grid,
    .body__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36em) {
    .row {
      grid-template-columns: 1fr;
    }

    .submit {
      justify-self: stretch;
      justify-content: center;
    }
  }
</style>
