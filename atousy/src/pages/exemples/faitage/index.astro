---
// Démonstration fictive « Faîtage » (charpentier) — page d'accueil.
import { Picture } from 'astro:assets';
import FaitageLayout from '../../../components/demos/faitage/FaitageLayout.astro';
import ContactBand from '../../../components/demos/faitage/ContactBand.astro';
import Icon from '../../../components/Icon.astro';
import faitage1 from '../../../assets/photos/faitage-1.jpg';
import faitage2 from '../../../assets/photos/faitage-2.jpg';
import faitage4 from '../../../assets/photos/faitage-4.jpg';
import faitage5 from '../../../assets/photos/faitage-5.jpg';
import faitage6 from '../../../assets/photos/faitage-6.jpg';

const pillars = [
  {
    title: 'Construire',
    text: 'Maisons à ossature bois, charpentes neuves, préaux : des structures dessinées pour votre terrain et votre usage.',
  },
  {
    title: 'Rénover',
    text: 'Diagnostic, renforcement et remplacement des pièces fatiguées, en respectant ce qui peut être conservé.',
  },
  {
    title: 'Transmettre',
    text: 'Des assemblages lisibles et réparables, et un métier que nous partageons volontiers sur le chantier.',
  },
];

const crafts = [
  { id: 'charpente', title: 'Charpente traditionnelle', text: 'Fermes, pannes et chevrons taillés et assemblés à l’atelier.' },
  { id: 'ossature', title: 'Ossature bois', text: 'Murs, planchers et toitures pour une maison saine et performante.' },
  { id: 'extensions', title: 'Extensions bois', text: 'Agrandir sans alourdir : une pièce de vie greffée sur l’existant.' },
  { id: 'renovation', title: 'Rénovation de charpente', text: 'Reprise, traitement et renforcement de structures anciennes.' },
  { id: 'couverture', title: 'Couverture', text: 'Tuiles, ardoises ou bac acier : la toiture complète, faîtage compris.' },
];

const steps = [
  { title: 'Visite & relevé', text: 'Nous venons voir le terrain ou le bâtiment, écouter vos besoins et prendre les mesures.' },
  { title: 'Conception', text: 'Plans, choix des essences et des assemblages, devis détaillé poste par poste.' },
  { title: 'Taille à l’atelier', text: 'Les pièces sont taillées, numérotées et pré-montées à l’abri, avant le chantier.' },
  { title: 'Levage & finitions', text: 'Mise en place rapide sur site, couverture, puis réception des travaux avec vous.' },
];
---

<FaitageLayout
  title="Faîtage — démonstration fictive | Atousy"
  description="Faîtage, charpentier fictif : charpente traditionnelle, ossature bois, extensions et rénovation. Site de démonstration réalisé par Atousy."
  current="accueil"
>
  <!-- Ouverture -->
  <section class="hero ft-on-photo" aria-labelledby="hero-title">
    <div class="hero__media">
      <Picture
        src={faitage1}
        alt="Préau en bois massif sur une terrasse en pierre, face aux montagnes"
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600, 2000, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="ft-container hero__inner">
      <div class="hero__content">
        <h1 id="hero-title">Des charpentes<br /> pour demain.</h1>
        <p class="hero__text">Construire, rénover, transmettre.<br /> Un savoir-faire local au service de vos projets.</p>
        <a class="ft-btn ft-btn--light" href="/exemples/faitage/realisations/">Découvrir le projet <Icon name="arrow" /></a>
      </div>
      <p class="hero__caption">Projet type · Préau en bois massif</p>
    </div>
  </section>

  <!-- 01 L'entreprise -->
  <section class="ft-section intro" aria-labelledby="intro-title">
    <div class="ft-container">
      <div class="intro__head">
        <p class="ft-label"><span class="ft-label__num">01</span>L’entreprise</p>
        <h2 id="intro-title" class="ft-h2">Le bois, du premier trait au dernier chevron.</h2>
        <div class="intro__copy">
          <p class="ft-lead">
            Faîtage dessine, taille et lève des charpentes et des maisons bois pensées pour durer plusieurs générations.
            Une seule équipe suit votre projet, de la visite jusqu’à la pose du faîtage.
          </p>
          <a class="ft-link" href="/exemples/faitage/atelier/">Découvrir l’atelier <Icon name="arrow" /></a>
        </div>
      </div>

      <ol class="pillars">
        {
          pillars.map((p, i) => (
            <li class="pillar">
              <span class="pillar__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 02 Savoir-faire -->
  <section class="ft-section crafts" aria-labelledby="crafts-title">
    <div class="ft-container crafts__grid">
      <div class="crafts__main">
        <p class="ft-label"><span class="ft-label__num">02</span>Savoir-faire</p>
        <h2 id="crafts-title" class="ft-h2">Ce que nous construisons.</h2>
        <ul class="craft-list">
          {
            crafts.map((c, i) => (
              <li>
                <a class="craft" href={`/exemples/faitage/savoir-faire/#${c.id}`}>
                  <span class="craft__num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="craft__body">
                    <span class="craft__title">{c.title}</span>
                    <span class="craft__text">{c.text}</span>
                  </span>
                  <Icon name="arrow" class="craft__arrow" />
                </a>
              </li>
            ))
          }
        </ul>
        <a class="ft-link crafts__more" href="/exemples/faitage/savoir-faire/">Tout notre savoir-faire <Icon name="arrow" /></a>
      </div>
      <figure class="crafts__media">
        <Picture
          src={faitage2}
          alt="Charpente neuve en cours de levage sur une maison, entourée d’échafaudages"
          formats={['avif', 'webp']}
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 60em) 100vw, 40vw"
        />
        <figcaption class="ft-caption">Projet type · Levage d’une charpente</figcaption>
      </figure>
    </div>
  </section>

  <!-- 03 Réalisations -->
  <section class="ft-section works" aria-labelledby="works-title">
    <div class="ft-container">
      <div class="works__head">
        <div>
          <p class="ft-label"><span class="ft-label__num">03</span>Réalisations</p>
          <h2 id="works-title" class="ft-h2">Des projets à vivre.</h2>
        </div>
        <p class="works__intro">
          Projets types présentés à titre d’illustration : maisons, extensions et charpentes, du plan à la réception.
        </p>
      </div>

      <div class="works__grid">
        <a class="work work--main" href="/exemples/faitage/realisations/#maison-ossature">
          <span class="work__img">
            <Picture
              src={faitage4}
              alt="Maison contemporaine à ossature et bardage bois dans une prairie de montagne"
              formats={['avif', 'webp']}
              widths={[640, 960, 1280, 1600]}
              sizes="(max-width: 48em) 100vw, 58vw"
            />
          </span>
          <span class="ft-caption">Projet type · Maison ossature bois</span>
          <span class="work__title">Une maison bois face aux sommets<Icon name="arrow" /></span>
        </a>
        <a class="work" href="/exemples/faitage/realisations/#extension">
          <span class="work__img">
            <Picture
              src={faitage6}
              alt="Extension en bois accolée à une maison ancienne en pierre"
              formats={['avif', 'webp']}
              widths={[480, 720, 960, 1200]}
              sizes="(max-width: 48em) 100vw, 38vw"
            />
          </span>
          <span class="ft-caption">Projet type · Extension bois</span>
          <span class="work__title">Une pièce de vie greffée sur la pierre<Icon name="arrow" /></span>
        </a>
      </div>

      <a class="ft-btn ft-btn--outline works__cta" href="/exemples/faitage/realisations/">Voir toutes les réalisations <Icon name="arrow" /></a>
    </div>
  </section>

  <!-- 04 Méthode -->
  <section class="ft-section method ft-dark" aria-labelledby="method-title">
    <div class="ft-container">
      <div class="method__head">
        <p class="ft-label"><span class="ft-label__num">04</span>Méthode</p>
        <h2 id="method-title" class="ft-h2">Du relevé au levage.</h2>
        <p class="ft-lead">Un interlocuteur unique et des étapes claires, pour savoir à chaque moment où en est votre projet.</p>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step">
              <span class="step__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 05 L'atelier -->
  <section class="workshop" aria-labelledby="workshop-title">
    <div class="workshop__media">
      <Picture
        src={faitage5}
        alt="Atelier de charpente baigné de lumière : poutres sur tréteaux, établi et outils"
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 60em) 100vw, 50vw"
      />
    </div>
    <div class="workshop__body">
      <p class="ft-label"><span class="ft-label__num">05</span>L’atelier</p>
      <h2 id="workshop-title" class="ft-h2">Un atelier où le bois prend son temps.</h2>
      <p class="ft-lead">
        Chaque pièce est choisie, tracée et taillée à l’abri avant de rejoindre le chantier. C’est là que se jouent la
        précision des assemblages et la rapidité du levage.
      </p>
      <a class="ft-link" href="/exemples/faitage/atelier/">Entrer dans l’atelier <Icon name="arrow" /></a>
    </div>
  </section>

  <ContactBand />
</FaitageLayout>

<style>
  /* ——— Ouverture ——— */
  .hero {
    position: relative;
    display: flex;
    min-height: clamp(34rem, calc(100svh - 7.5rem), 52rem);
    color: var(--ft-white);
    background: var(--ft-charcoal);
    isolation: isolate;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__media :global(picture) {
    height: 100%;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 50%;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(28 20 12 / 0.74) 0%, rgb(28 20 12 / 0.4) 42%, rgb(28 20 12 / 0) 72%),
      linear-gradient(0deg, rgb(28 20 12 / 0.55) 0%, rgb(28 20 12 / 0) 40%);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2rem, 5vw, 3.5rem);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 40rem;
  }

  .hero h1 {
    color: var(--ft-white);
    font-size: clamp(3rem, 1.6rem + 5.4vw, 6.4rem);
    font-weight: 420;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .hero__text {
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.3125rem);
    line-height: 1.55;
    color: rgb(251 249 245 / 0.92);
  }

  .hero .ft-btn {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .hero__caption {
    align-self: flex-end;
    margin-top: 2.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(251 249 245 / 0.85);
  }

  /* ——— 01 L'entreprise ——— */
  .intro__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.5vw, 2rem);
    align-items: end;
  }

  .intro__head .ft-label {
    grid-column: 1 / -1;
  }

  .intro__head h2 {
    grid-column: 1 / span 7;
  }

  .intro__copy {
    grid-column: 8 / -1;
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem clamp(1.5rem, 3vw, 3rem);
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    padding: 0;
    list-style: none;
  }

  .pillar {
    padding-top: 1.5rem;
    border-top: 1px solid var(--ft-line-strong);
  }

  .pillar__num {
    display: block;
    margin-bottom: 2.5rem;
    font-size: 0.875rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    color: var(--ft-wood-ink);
  }

  .pillar h3 {
    font-family: var(--ft-serif);
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem);
    font-weight: 450;
    letter-spacing: -0.02em;
  }

  .pillar p {
    max-width: 34ch;
    margin-top: 0.75rem;
    color: var(--ft-ink-2);
  }

  /* ——— 02 Savoir-faire ——— */
  .crafts {
    background: var(--ft-sand);
  }

  .crafts__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 3rem clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .craft-list {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ft-line-strong);
  }

  .craft-list li {
    border-bottom: 1px solid var(--ft-line-strong);
  }

  .craft {
    display: grid;
    grid-template-columns: 2.75rem 1fr auto;
    align-items: center;
    gap: 1rem;
    padding-block: 1.25rem;
    color: var(--ft-ink);
    text-decoration: none;
    transition: padding 0.35s var(--ft-ease);
  }

  .craft__num {
    align-self: start;
    padding-top: 0.3rem;
    font-size: 0.875rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    color: var(--ft-wood-ink);
  }

  .craft__body {
    display: grid;
    gap: 0.2rem;
  }

  .craft__title {
    font-family: var(--ft-serif);
    font-size: clamp(1.4rem, 1.2rem + 0.7vw, 1.75rem);
    font-weight: 450;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .craft__text {
    color: var(--ft-ink-2);
    font-size: 0.9688rem;
  }

  .craft :global(.craft__arrow) {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--ft-wood-ink);
    transition: transform 0.3s var(--ft-ease);
  }

  .craft:hover .craft__title {
    color: var(--ft-wood-ink);
  }

  .craft:hover :global(.craft__arrow) {
    transform: translate(3px, -3px);
  }

  .craft:focus-visible {
    outline-offset: 0;
  }

  .crafts__more {
    margin-top: 2rem;
  }

  .crafts__media {
    position: sticky;
    top: 7rem;
    display: grid;
    gap: 0.9rem;
  }

  .crafts__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 45% 50%;
  }

  /* ——— 03 Réalisations ——— */
  .works__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .works__intro {
    max-width: 30rem;
    color: var(--ft-ink-2);
  }

  .works__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 2.5rem clamp(1.25rem, 3vw, 2.5rem);
    align-items: end;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .work {
    display: grid;
    gap: 0.85rem;
    color: var(--ft-ink);
    text-decoration: none;
  }

  .work__img {
    display: block;
    overflow: hidden;
    background: var(--ft-sand);
  }

  .work__img :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 0.8s var(--ft-ease);
  }

  .work--main .work__img :global(img) {
    aspect-ratio: 5 / 4;
  }

  .work:hover .work__img :global(img) {
    transform: scale(1.03);
  }

  .work .ft-caption {
    margin-top: 0.35rem;
  }

  .work__title {
    display: block;
    font-family: var(--ft-serif);
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.875rem);
    font-weight: 450;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .work__title :global(svg) {
    display: inline-block;
    width: 1.1rem;
    height: 1.1rem;
    margin-left: 0.5rem;
    vertical-align: -0.05em;
    color: var(--ft-wood-ink);
    transition: transform 0.3s var(--ft-ease);
  }

  .work:hover .work__title {
    color: var(--ft-wood-ink);
  }

  .work:hover .work__title :global(svg) {
    transform: translate(2px, -2px);
  }

  .works__cta {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* ——— 04 Méthode ——— */
  .method__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.5vw, 2rem);
    align-items: end;
  }

  .method__head .ft-label {
    grid-column: 1 / -1;
  }

  .method__head h2 {
    grid-column: 1 / span 6;
  }

  .method__head .ft-lead {
    grid-column: 8 / -1;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem clamp(1.25rem, 2.5vw, 2.5rem);
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .step {
    position: relative;
    padding-top: 1.75rem;
    border-top: 1px solid var(--ft-line-light);
  }

  .step::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 2.5rem;
    height: 2px;
    background: var(--ft-wood-light);
  }

  .step__num {
    display: block;
    margin-bottom: 1.5rem;
    font-family: var(--ft-serif);
    font-size: clamp(2.75rem, 2rem + 2vw, 3.75rem);
    font-weight: 350;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--ft-wood-light);
  }

  .step h3 {
    font-size: 1.1875rem;
  }

  .step p {
    margin-top: 0.6rem;
    color: rgb(251 249 245 / 0.75);
    font-size: 0.9688rem;
  }

  /* ——— 05 L'atelier ——— */
  .workshop {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: var(--ft-white);
  }

  .workshop__media {
    min-height: 28rem;
  }

  .workshop__media :global(picture),
  .workshop__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .workshop__media :global(img) {
    object-fit: cover;
  }

  .workshop__body {
    align-self: center;
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    max-width: 38rem;
    padding: clamp(3.5rem, 8vw, 7rem) var(--ft-gutter);
  }

  .workshop__body .ft-label {
    margin-bottom: 0.15rem;
  }

  /* ——— Responsive ——— */
  @media (max-width: 60em) {
    .intro__head h2,
    .intro__copy,
    .method__head h2,
    .method__head .ft-lead {
      grid-column: 1 / -1;
    }

    .intro__copy,
    .method__head .ft-lead {
      margin-top: 1.5rem;
    }

    .crafts__grid {
      grid-template-columns: 1fr;
    }

    .crafts__media {
      position: static;
    }

    .crafts__media :global(img) {
      aspect-ratio: 3 / 2;
    }

    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .workshop {
      grid-template-columns: 1fr;
    }

    .workshop__media {
      min-height: 0;
    }

    .workshop__media :global(img) {
      aspect-ratio: 3 / 2;
    }
  }

  @media (max-width: 48em) {
    .pillars {
      grid-template-columns: 1fr;
    }

    .pillar__num {
      margin-bottom: 1rem;
    }

    .works__grid {
      grid-template-columns: 1fr;
    }

    .work__img :global(img),
    .work--main .work__img :global(img) {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 34em) {
    .hero {
      min-height: clamp(32rem, calc(100svh - 8rem), 44rem);
    }

    .hero__shade {
      background:
        linear-gradient(0deg, rgb(28 20 12 / 0.82) 0%, rgb(28 20 12 / 0.45) 50%, rgb(28 20 12 / 0.1) 100%);
    }

    .hero__caption {
      align-self: flex-start;
      margin-top: 2rem;
    }

    .steps {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .step {
      display: grid;
      grid-template-columns: 3.75rem 1fr;
      column-gap: 0.5rem;
      padding-top: 1.25rem;
    }

    .step__num {
      grid-row: span 2;
      margin-bottom: 0;
      font-size: 2.5rem;
    }

    .step p {
      margin-top: 0.35rem;
    }

    .craft {
      grid-template-columns: 2.25rem 1fr auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work:hover .work__img :global(img),
    .craft:hover :global(.craft__arrow),
    .work:hover .work__title :global(svg) {
      transform: none;
    }
  }
</style>
