        <td role="cell" data-label="Base du transfert">Pays de l’Union européenne, dont le niveau de protection est reconnu adéquat par la Suisse</td>
      </tr>
      <tr role="row">
        <th scope="row" role="rowheader">Resend <Todo label="SI RETENU" /></th>
        <td role="cell" data-label="Rôle">Envoi des e-mails du formulaire</td>
        <td role="cell" data-label="Pays">États-Unis</td>
        <td role="cell" data-label="Base du transfert">
          Clauses contractuelles types de l’UE, adaptées au droit suisse (accord de traitement des données de Resend)
        </td>
      </tr>
      <tr role="row">
        <th scope="row" role="rowheader"><Todo>fournisseur de la boîte contact@atousy.com</Todo></th>
        <td role="cell" data-label="Rôle">Messagerie : réception et conservation des demandes</td>
        <td role="cell" data-label="Pays"><Todo>pays</Todo></td>
