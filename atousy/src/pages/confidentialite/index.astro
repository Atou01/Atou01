        <td role="cell" data-label="Base du transfert">
          Organisation certifiée Data Privacy Framework (UE–États-Unis et Suisse–États-Unis)
          {' '}<Todo label="À VÉRIFIER">certification active sur dataprivacyframework.gov</Todo>
        </td>
      </tr>
      <tr role="row">
        <th scope="row" role="rowheader">Brevo <Todo label="SI RETENU" /></th>
