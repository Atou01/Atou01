---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Gallery from '../components/home/Gallery.astro';
import OfferBand from '../components/home/OfferBand.astro';
import Method from '../components/home/Method.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

// Données structurées volontairement minimales : rien d'invérifiable (ni adresse, ni avis).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: new URL('/icon-512.png', site.url).href,
  description: 'Studio web & design : création et refonte de sites vitrines pour artisans, TPE et PME.',
};
---

<BaseLayout
  title="Création et refonte de sites : artisans, TPE, PME | Atousy"
  description="Studio web & design : création et refonte de sites vitrines pour artisans, TPE et PME. Devis clair, maquette à valider, site pensé pour recevoir des demandes."
  overlayHeader
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Hero />
  <Gallery />
  <OfferBand />
  <Method />
  <CtaBand />
</BaseLayout>
