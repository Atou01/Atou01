---
// Demande de devis. Textes : contenus/devis.md (brouillon à valider).
// En-tête commun des pages intérieures (fil d'Ariane, H1 à la même échelle) ; pas d'InnerLayout,
// dont le bandeau final « Demander un devis » ferait doublon ici.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/pages/PageHero.astro';
import DevisForm from '../../components/devis/DevisForm.astro';
import NextSteps from '../../components/devis/NextSteps.astro';
import { site } from '../../data/site';

const hasTurnstile = Boolean(String(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '').trim());
const crumb = 'Demander un devis';

// Données structurées : seulement le fil d'Ariane, comme sur les autres pages intérieures.
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', site.url).href },
    { '@type': 'ListItem', position: 2, name: crumb, item: new URL(Astro.url.pathname, site.url).href },
  ],
};
---

<BaseLayout
  title="Demander un devis pour votre site | Atousy"
  description="Décrivez votre projet de création ou de refonte de site vitrine en quelques questions. Atousy revient vers vous par e-mail avec un devis clair et détaillé."
>
  {hasTurnstile && <link slot="head" rel="preconnect" href="https://challenges.cloudflare.com" />}
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  {/* Retour à la ligne voulu : « de » reste avec « votre projet », jamais en fin de ligne. */}
  <PageHero
    crumb={crumb}
    title={'Parlons\nde votre projet.'}
    lead="Quelques questions pour comprendre votre besoin. Nous revenons vers vous par e-mail avec les prochaines étapes."
  />

  <div class="container devis-layout">
    <div class="devis-layout__main">
      <DevisForm />
    </div>
    <div class="devis-layout__aside">
      <NextSteps />
    </div>
  </div>
</BaseLayout>

<style>
  .devis-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(19rem, 25rem);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
    padding-bottom: clamp(4rem, 8vw, 7.5rem);
  }

  .devis-layout__main {
    max-width: 46rem;
  }

  .devis-layout__aside {
    position: sticky;
    top: 1.5rem;
  }

  @media (max-width: 62.49em) {
    .devis-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 3.5rem;
    }

    .devis-layout__main {
      max-width: none;
    }

    .devis-layout__aside {
      position: static;
    }
  }
</style>
