---
// Aperçu de la page d'accueil d'une démonstration fictive, dessiné en HTML (pas une capture d'écran).
// Purement décoratif (aria-hidden) : le lien et son libellé sont posés par le parent.
// Toutes les mesures suivent la largeur de la fenêtre (cqw, ou em d'un texte en cqw), format 16:10.
// Chaque aperçu reprend l'ouverture réelle de la démo (src/pages/exemples/<id>/index.astro) :
// mêmes mots, mêmes couleurs, même logo, même photo, en grossissant un peu les textes.
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import EIcon from '../demos/ecluse/EIcon.astro';
import MIcon from '../demos/moellon/MIcon.astro';
import type { DemoId, DemoWindowId } from '../../data/pages/demos';
import rivage1 from '../../assets/photos/rivage-1.jpg';
import faitage1 from '../../assets/photos/faitage-1.jpg';
import ecluse1 from '../../assets/photos/ecluse-1.jpg';
import lueur1 from '../../assets/photos/lueur-1.jpg';
import moellon1 from '../../assets/photos/moellon-1.jpg';
import '@fontsource-variable/newsreader/wght.css';

interface Props {
  id: DemoWindowId;
  /** sizes de l'image (elle occupe toute la largeur de la fenêtre). */
  sizes?: string;
  eager?: boolean;
  priority?: boolean;
}

const { id, sizes = '(max-width: 40em) 82vw, 36vw', eager = false, priority = false } = Astro.props;

const demo = id.replace(/-accueil$/, '') as DemoId;
const loading = eager ? ('eager' as const) : ('lazy' as const);
const prio = priority ? { fetchpriority: 'high' as const } : {};
const full = { formats: ['avif', 'webp'] as const, alt: '', widths: [480, 720, 1080], sizes, loading, ...prio };

const rivageLinks = ['Notre approche', 'Savoir-faire', 'Votre jardin'];
const faitageLinks = ['Accueil', 'Réalisations', 'Savoir-faire', 'L’atelier'];
const ecluseLinks = ['Accueil', 'Services', 'Réalisations', 'Entretien'];
const lueurLinks = ['Accueil', 'Prestations', 'Réalisations', 'Conseils'];
const moellonLinks = ['Accueil', 'Savoir-faire', 'Chantiers', 'Notre approche'];
---

<span class:list={['w', `w--${demo}`]} aria-hidden="true">
  {
    demo === 'rivage' && (
      <>
        <span class="rv-nav">
          <span class="rv-logo">
            {/* Vague reprise de src/components/demos/rivage/Logo.astro */}
            <svg class="rv-wave" viewBox="0 0 22 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <path d="M1.5 4.6c2.2-2.4 4.4-2.4 6.6 0s4.4 2.4 6.6 0 4.4-2.4 6.6 0" />
              <path d="M1.5 10.4c2.2-2.4 4.4-2.4 6.6 0s4.4 2.4 6.6 0 4.4-2.4 6.6 0" />
            </svg>
            rivage
          </span>
          <span class="rv-links">
            {rivageLinks.map((l) => (
              <span>{l}</span>
            ))}
          </span>
          <span class="rv-cta">Nous contacter</span>
        </span>
        <span class="w-img w-img--below-rv">
          <Picture src={rivage1} {...full} />
        </span>
        <span class="w-shade rv-shade w-img--below-rv" />
        <span class="rv-copy">
          <span class="rv-title">
            Le jardin
            <br />
            vous appelle.
          </span>
          <span class="w-text rv-text">Des lieux pour ralentir, se retrouver et regarder les saisons passer. Le paysage commence avec votre façon de vivre.</span>
          <span class="rv-btn">
            Entrer dans le jardin <Icon name="arrow" />
          </span>
        </span>
        <span class="rv-aside">
          Des paysages pour vivre dehors.
          <br />
          En toute saison.
        </span>
      </>
    )
  }

  {
    demo === 'faitage' && (
      <>
        <span class="ft-nav">
          <span class="ft-logo">
            {/* Ligne de faîtage reprise de src/components/demos/faitage/Logo.astro */}
            <svg class="ft-ridge" viewBox="0 0 26 14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" stroke-linejoin="miter">
              <path d="M2 12.5 13 2.5l11 10" />
            </svg>
            Faîtage
          </span>
          <span class="ft-links">
            {faitageLinks.map((l, i) => (
              <span class:list={{ 'is-on': i === 0 }}>{l}</span>
            ))}
          </span>
          <span class="ft-cta">
            Contact <Icon name="arrow" />
          </span>
        </span>
        <span class="w-img w-img--below-ft">
          <Picture src={faitage1} {...full} />
        </span>
        <span class="w-shade ft-shade w-img--below-ft" />
        <span class="ft-copy">
          <span class="ft-title">
            Des charpentes
            <br />
            pour demain.
          </span>
          <span class="w-text ft-text">
            Construire, rénover, transmettre.
            <br />
            Un savoir-faire local au service de vos projets.
          </span>
          <span class="ft-btn">
            Découvrir le projet <Icon name="arrow" />
          </span>
        </span>
        <span class="ft-caption">Projet type · Préau en bois massif</span>
      </>
    )
  }

  {
    demo === 'ecluse' && (
      <>
        <span class="ec-nav">
          <span class="ec-logo">
            {/* Pictogramme repris de src/components/demos/ecluse/Logo.astro */}
            <svg class="ec-glyph" viewBox="0 0 28 28">
              <rect x="0.5" y="0.5" width="27" height="27" rx="8" fill="#2f4a5a" />
              <path d="M14 4.8c3.5 4.3 6.4 7.8 6.4 11.5a6.4 6.4 0 0 1-12.8 0c0-3.7 2.9-7.2 6.4-11.5z" fill="#fff" />
              <path d="M7.66 17.1H14v-3.3h6.27c.09.84.13 1.67.13 2.5a6.4 6.4 0 0 1-12.8 0c0-.43.02-.83.06-1.2z" fill="#b38f58" />
            </svg>
            écluse
          </span>
          <span class="ec-links">
            {ecluseLinks.map((l, i) => (
              <span class:list={{ 'is-on': i === 0 }}>{l}</span>
            ))}
          </span>
          <span class="ec-cta">
            Contact <EIcon name="arrow" />
          </span>
        </span>
        <span class="ec-frame">
          <Picture src={ecluse1} {...full} />
          <span class="ec-veil" />
          <span class="ec-copy">
            <span class="ec-title">
              La chaleur
              <br />
              et l’eau,
              <br />
              bien installées.
            </span>
            <span class="w-text ec-text">Salles de bain, chauffage, pompes à chaleur et dépannage : un artisan qui explique avant d’intervenir.</span>
            <span class="ec-btn">
              Voir nos réalisations
              <span class="ec-btn__icon">
                <EIcon name="arrow" />
              </span>
            </span>
          </span>
          <span class="ec-caption">Projet type · Douche à l’italienne</span>
        </span>
      </>
    )
  }

  {
    demo === 'lueur' && (
      <>
        <span class="w-img">
          <Picture src={lueur1} {...full} />
        </span>
        <span class="w-shade lu-scrim" />
        <span class="lu-nav">
          <span class="lu-logo">
            {/* Filament repris de src/components/demos/lueur/Logo.astro */}
            <svg class="lu-glyph" viewBox="0 0 28 28" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path class="lu-glyph__halo" d="M7.5 19.5c0-6.2 2.9-10.5 6.5-10.5s6.5 4.3 6.5 10.5" />
              <path class="lu-glyph__arc" d="M7.5 19.5c0-6.2 2.9-10.5 6.5-10.5s6.5 4.3 6.5 10.5" />
              <path class="lu-glyph__leads" d="M7.5 19.5v5M20.5 19.5v5" />
              <circle class="lu-glyph__spark" cx="14" cy="3.6" r="1.35" />
            </svg>
            <span class="lu-word">Lueur</span>
          </span>
          <span class="lu-links">
            {lueurLinks.map((l, i) => (
              <span class:list={{ 'is-on': i === 0 }}>{l}</span>
            ))}
          </span>
          <span class="lu-cta">
            Contact <Icon name="arrow" />
          </span>
        </span>
        <span class="lu-copy">
          <span class="lu-title">
            Une maison
            <br />
            <span class="lu-glow">bien éclairée</span>, une
            <br />
            installation sûre.
          </span>
          <span class="w-text lu-text">Rénovation électrique, tableaux, éclairage et bornes de recharge : un travail propre et expliqué.</span>
          <span class="lu-btn">
            Découvrir nos prestations <Icon name="arrow" />
          </span>
        </span>
        <span class="lu-caption">Projet type · Séjour rénové, éclairage d’ambiance</span>
      </>
    )
  }

  {
    demo === 'moellon' && (
      <>
        <span class="mo-nav">
          <span class="mo-logo">
            {/* Moellons repris de src/components/demos/moellon/Logo.astro */}
            <svg class="mo-stones" viewBox="0 0 31 28">
              <path fill="#a4532c" d="M10 2.2c3-.9 8.5-.8 11.6.2 1.4.5 1.9 1.7 1.6 3.1l-.5 2.3c-.3 1.1-1.2 1.7-2.3 1.7H9.7c-1.2 0-2.1-.8-2.2-2l-.2-2.2C7.2 3.9 8.3 2.7 10 2.2Z" />
              <path fill="#2b211a" d="M2.6 11.6c2.7-.7 7.6-.8 10.6-.2 1.2.3 1.8 1.2 1.8 2.4v3.4c0 1.2-.9 2.1-2.1 2.1H3c-1.3 0-2.3-1-2.2-2.3l.1-3.3c.1-1 .7-1.8 1.7-2.1Z" />
              <path fill="#b88a5e" d="M18.3 11.3c3-.5 7.4-.3 9.9.4 1.1.3 1.8 1.3 1.7 2.5l-.2 3.1c-.1 1.2-1 2.1-2.2 2.1h-9.2c-1.2 0-2.1-1-2-2.2l.2-3.6c.1-1.2.7-2.1 1.8-2.3Z" />
              <path fill="#2b211a" d="M1.9 21.5c4.1-.6 11.3-.6 15.3 0 1.2.2 2 1.1 2 2.3v1.3c0 1.3-1 2.3-2.3 2.3H2c-1.2 0-2-.9-2-2.1l.1-1.7c0-1.1.7-1.9 1.8-2.1Z" />
              <path fill="#a4532c" d="M23 21.4c2.1-.3 4.5-.2 6 .2 1 .3 1.6 1.1 1.6 2.1v1.6c0 1.2-1 2.2-2.2 2.2h-5.5c-1.2 0-2.1-1-2.1-2.2l.1-1.8c.1-1.1.9-1.9 2.1-2.1Z" />
            </svg>
            Moellon
          </span>
          <span class="mo-links">
            {moellonLinks.map((l, i) => (
              <span class:list={{ 'is-on': i === 0 }}>{l}</span>
            ))}
          </span>
          <span class="mo-btn mo-cta">
            Contact <MIcon name="arrow" />
          </span>
        </span>
        <span class="w-img w-img--below-mo">
          <Picture src={moellon1} {...full} />
        </span>
        <span class="w-shade mo-wash w-img--below-mo" />
        <span class="mo-copy">
          <span class="mo-kicker">Maçonnerie &amp; rénovation</span>
          <span class="mo-title">
            Rénover la pierre,
            <br />
            bâtir pour durer.
          </span>
          <span class="w-text mo-text">Maçonnerie, extensions, ouvertures et rénovation de maisons anciennes, avec des matériaux qui respectent le bâti.</span>
          <span class="mo-btn">
            Voir les chantiers <MIcon name="arrow" />
          </span>
        </span>
        <span class="mo-caption">Projet type · Maison en pierre</span>
      </>
    )
  }
</span>

<style>
  .w {
    --serif: 'Newsreader Variable', Georgia, serif;
    /* Rivage, Faîtage : jetons repris de leur gabarit (src/components/demos/<id>/*Layout.astro) */
    --rv-green: #1e3328;
    --rv-ivory: #f6f1e6;
    --rv-ink: #1b2620;
    --rv-line: rgb(30 51 40 / 0.14);
    --ft-white: #fbf9f5;
    --ft-ink: #2b2219;
    --ft-charcoal: #221f1c;
    --ft-wood: #b06d34;
    --ft-line: rgb(43 34 25 / 0.14);
    /* Écluse, Lueur, Moellon : jetons repris de leur gabarit (src/components/demos/<id>/*Layout.astro) */
    --ec-mist: #f2f5f7;
    --ec-ink: #142430;
    --ec-ink-2: #44535e;
    --ec-slate: #2f4a5a;
    --ec-brass-light: #dcc394;
    --ec-line: rgb(29 50 64 / 0.12);
    --lu-night: #141a24;
    --lu-ivory: #f5efe4;
    --lu-amber: #f2b45a;
    --mo-lime: #e9dfcf;
    --mo-cream: #faf6ef;
    --mo-ink: #2b211a;
    --mo-ink-2: #5a4a3d;
    --mo-terra: #a4532c;
    --mo-terra-ink: #7f3b1d;
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    container-type: inline-size;
    border-radius: 3px;
    font-family: var(--font-sans);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
    text-align: left;
    white-space: normal;
    user-select: none;
    -webkit-user-select: none;
  }

  .w--rivage {
    background: var(--rv-ivory);
    color: var(--rv-ink);
  }

  .w--faitage {
    background: var(--ft-white);
    color: var(--ft-ink);
  }

  .w--ecluse {
    background: #fff;
    color: var(--ec-ink);
  }

  .w--lueur {
    background: var(--lu-night);
    color: var(--lu-ivory);
  }

  .w--moellon {
    background: var(--mo-lime);
    color: var(--mo-ink);
  }

  .w :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-user-drag: none;
    user-select: none;
  }

  .w :global(picture) {
    position: absolute;
    inset: 0;
  }

  .w :global(svg) {
    display: inline-block;
    width: 1.15em;
    height: 1.15em;
    flex: none;
  }

  /* ---------- Rivage : ivoire et vert profond ; mesures reprises de la démo à 1440 px de large ---------- */
  .rv-nav {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 3.8cqw;
    height: 7.6cqw;
    padding-inline: 7.2cqw;
    border-bottom: max(1px, 0.1cqw) solid var(--rv-line);
    background: var(--rv-ivory);
    font-size: 1.35cqw;
    font-weight: 500;
    white-space: nowrap;
  }

  .rv-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.27em;
    margin-right: auto;
    color: var(--rv-green);
    font-family: var(--serif);
    font-size: 2.9cqw;
    font-weight: 430;
    line-height: 1;
    letter-spacing: -0.015em;
  }

  /* Vague : mêmes proportions que dans le logo de la démo (1,05rem pour un mot de 1,875rem) */
  .w .rv-wave {
    width: 0.56em;
    height: auto;
    margin-top: 0.11em;
    opacity: 0.75;
  }

  .rv-links {
    display: flex;
    gap: 3.2cqw;
  }

  /* Bouton « Nous contacter » : marges en em, comme rv-btn--sm dans la démo */
  .rv-cta {
    padding: 0.75em 1.23em;
    border-radius: 0.27em;
    background: var(--rv-green);
    color: var(--rv-ivory);
    font-size: 0.97em;
    font-weight: 550;
  }

  /* ---------- Faîtage : blanc cassé, brun, bois ; mesures reprises de la démo à 1440 px de large ---------- */
  .ft-nav {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 2.75cqw;
    height: 8cqw;
    padding-inline: 4.45cqw;
    border-bottom: max(1px, 0.1cqw) solid var(--ft-line);
    background: var(--ft-white);
    font-size: 1.35cqw;
    font-weight: 550;
    white-space: nowrap;
  }

  .ft-logo {
    display: inline-flex;
    align-items: flex-end;
    gap: 0.31em;
    margin-right: auto;
    font-family: var(--serif);
    font-size: 2.5cqw;
    font-weight: 520;
    line-height: 1;
    letter-spacing: -0.015em;
  }

  /* Ligne de faîtage : mêmes proportions que dans le logo de la démo (1,35rem pour un mot de 1,6rem) */
  .w .ft-ridge {
    width: 0.84em;
    height: auto;
    margin-bottom: 0.21em;
    color: var(--ft-wood);
  }

  .ft-links {
    display: flex;
    align-self: stretch;
    gap: 2.75cqw;
  }

  .ft-links span {
    position: relative;
    display: flex;
    align-items: center;
  }

  /* Page courante : trait bois posé sur le filet bas de l'en-tête, comme dans la démo */
  .ft-links .is-on::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(-1 * max(1px, 0.1cqw));
    height: max(1px, 0.2cqw);
    background: var(--ft-wood);
  }

  /* Contact : bouton brun foncé, marges en em comme dans la démo */
  .ft-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    height: 3em;
    margin-left: 0.75em;
    padding-inline: 1.15em;
    border-radius: 0.13em;
    background: var(--ft-charcoal);
    color: var(--ft-white);
  }

  .ft-cta :global(svg) {
    width: 1.05em;
    height: 1.05em;
  }

  /* ---------- Héros photo (Rivage, Faîtage, Lueur, Moellon) ---------- */
  .w-img {
    position: absolute;
    inset: 0;
  }

  .w-img--below-rv {
    top: 7.6cqw;
  }

  .w-img--below-ft {
    top: 8cqw;
  }

  .w-shade {
    position: absolute;
    inset: 0;
  }

  /* Rivage : cadrage, voile et ouverture de la démo, alignés sur l'en-tête */
  .w--rivage :global(img) {
    object-position: 50% 55%;
  }

  .rv-shade {
    background:
      linear-gradient(90deg, rgb(10 25 18 / 0.72) 0%, rgb(10 25 18 / 0.42) 38%, rgb(10 25 18 / 0) 64%),
      linear-gradient(0deg, rgb(10 25 18 / 0.55) 0%, rgb(10 25 18 / 0.2) 22%, rgb(10 25 18 / 0) 45%);
  }

  .rv-copy {
    position: absolute;
    z-index: 1;
    left: 7.2cqw;
    bottom: 5cqw;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2cqw;
    max-width: 44cqw;
    color: #fff;
  }

  .rv-title {
    display: block;
    font-family: var(--serif);
    font-size: 8cqw;
    font-weight: 380;
    line-height: 0.95;
    letter-spacing: -0.032em;
  }

  /* 24em : la largeur de la démo (30rem pour un texte de 1,25rem), donc les mêmes retours à la ligne */
  .rv-text {
    display: block;
    max-width: 24em;
    color: rgb(255 255 255 / 0.92);
    font-size: 1.55cqw;
    line-height: 1.6;
  }

  .rv-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.85em;
    margin-top: 0.5cqw;
    padding: 0.95em 1.45em;
    border-radius: 0.25em;
    background: #fff;
    color: var(--rv-ink);
    font-size: 1.45cqw;
    font-weight: 550;
    line-height: 1.2;
  }

  .rv-aside {
    position: absolute;
    z-index: 1;
    right: 7.2cqw;
    bottom: 5cqw;
    padding-top: 1.1cqw;
    border-top: max(1px, 0.1cqw) solid rgb(255 255 255 / 0.55);
    color: #fff;
    font-family: var(--serif);
    font-size: 1.75cqw;
    font-style: italic;
    font-weight: 350;
    line-height: 1.35;
    text-shadow: 0 0.07cqw 0.85cqw rgb(10 25 18 / 0.45);
  }

  /* Faîtage : cadrage, voile et ouverture de la démo ; la légende passe sous le bouton, à droite */
  .w--faitage :global(img) {
    object-position: 30% 50%;
  }

  .ft-shade {
    background:
      linear-gradient(90deg, rgb(28 20 12 / 0.74) 0%, rgb(28 20 12 / 0.4) 42%, rgb(28 20 12 / 0) 72%),
      linear-gradient(0deg, rgb(28 20 12 / 0.55) 0%, rgb(28 20 12 / 0) 40%);
  }

  .ft-copy {
    position: absolute;
    z-index: 1;
    left: 4.45cqw;
    bottom: 8.3cqw;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 52cqw;
    color: var(--ft-white);
  }

  .ft-title {
    display: block;
    font-family: var(--serif);
    font-size: 7.1cqw;
    font-weight: 420;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .ft-text {
    display: block;
    margin-top: 2cqw;
    color: rgb(251 249 245 / 0.92);
    font-size: 1.55cqw;
    line-height: 1.55;
  }

  .ft-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.9em;
    min-height: 3.25em;
    margin-top: 2.8cqw;
    padding: 0.85em 1.4em;
    border-radius: 0.13em;
    background: var(--ft-white);
    color: var(--ft-ink);
    font-size: 1.45cqw;
    font-weight: 600;
    line-height: 1.2;
  }

  .rv-btn :global(svg),
  .ft-btn :global(svg) {
    width: 1.1em;
    height: 1.1em;
  }

  .ft-caption {
    position: absolute;
    z-index: 1;
    right: 4.45cqw;
    bottom: 3.9cqw;
    color: rgb(251 249 245 / 0.85);
    font-size: 1.05cqw;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
