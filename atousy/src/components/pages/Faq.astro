---
// Questions fréquentes en <details> / <summary> (fonctionne sans JavaScript).
// Les questions restent des H3 ; les réponses peuvent contenir un lien.
import Icon from '../Icon.astro';

export interface FaqItem {
  q: string;
  a: string;
  link?: { href: string; label: string };
}

interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq__item">
        <summary>
          <h3>{item.q}</h3>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <div class="faq__answer">
          <p>{item.a}</p>
          {item.link && (
            <a class="link-arrow" href={item.link.href}>
              <span>{item.link.label}</span>
              <Icon name="arrow" />
            </a>
          )}
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--line-strong);
  }

  .faq__item {
    border-bottom: 1px solid var(--line-strong);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.15rem;
    list-style: none;
    cursor: pointer;
    border-radius: var(--radius);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  h3 {
    font-size: clamp(1.0625rem, 1.35vw, 1.25rem);
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.35;
    text-wrap: pretty;
  }

  summary:hover h3 {
    color: var(--coral-text);
  }

  /* Plus / moins dessiné en CSS */
  .faq__icon {
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border: 1.5px solid var(--marine);
    border-radius: 50%;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.8rem;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 0.25s var(--ease);
  }

  .faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq__item[open] .faq__icon {
    background: var(--marine);
    color: var(--paper);
  }

  .faq__item[open] .faq__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq__answer {
    max-width: 44rem;
    padding: 0 3.5rem 1.4rem 0;
  }

  .faq__answer p {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .faq__answer .link-arrow {
    margin-top: 0.85rem;
  }

  @media (max-width: 40em) {
    .faq__answer {
      padding-right: 0;
    }
  }
</style>
