---
// Section de page intérieure : filet fin en haut, H2 à gauche et contenu à droite
// (layout « split ») ou H2 au-dessus du contenu (layout « stack »). Ton marine possible.
interface Props {
  id: string;
  title: string;
  /** Phrase d'introduction sous le H2. */
  lead?: string;
  tone?: 'ivory' | 'marine';
  layout?: 'split' | 'stack';
}
const { id, title, lead, tone = 'ivory', layout = 'split' } = Astro.props;
---

<section class:list={['ps', `ps--${tone}`, `ps--${layout}`, { 'ip-dark': tone === 'marine' }]} aria-labelledby={id}>
  <div class="container ps__inner">
    <div class="ps__head">
      <h2 id={id}>{title}</h2>
      {lead && <p class="ps__lead">{lead}</p>}
      <slot name="head" />
    </div>
    <div class="ps__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .ps {
    padding-bottom: clamp(3rem, 5.5vw, 5.5rem);
  }

  .ps__inner {
    display: grid;
    gap: 1.5rem clamp(2rem, 6vw, 6.5rem);
    padding-top: clamp(1.75rem, 3vw, 3rem);
    border-top: 1px solid var(--line);
  }

  h2 {
    max-width: 14ch;
    font-size: var(--fs-h2-sm);
  }

  .ps__lead {
    max-width: 30rem;
    margin-top: 1.1rem;
    font-size: clamp(1.0625rem, 1.25vw, 1.1875rem);
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* Bandeau marine */
  .ps--marine {
    padding-block: clamp(3rem, 5.5vw, 5.5rem);
    background: var(--marine-band);
    color: var(--paper);
  }

  .ps--marine .ps__inner {
    padding-top: 0;
    border-top: 0;
  }

  .ps--marine .ps__lead {
    color: rgb(255 253 250 / 0.82);
  }

  /* Après un bandeau marine, la section suivante n'a pas besoin de filet. */
  .ps--marine + .ps--ivory {
    padding-top: clamp(3rem, 5.5vw, 5.5rem);
  }

  .ps--marine + .ps--ivory .ps__inner {
    padding-top: 0;
    border-top: 0;
  }

  @media (min-width: 52em) {
    .ps--split .ps__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .ps--stack .ps__head {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 1.5rem clamp(2rem, 6vw, 6.5rem);
      align-items: end;
    }

    .ps--stack .ps__lead {
      margin-top: 0;
      padding-bottom: 0.3rem;
    }

    .ps--stack .ps__body {
      margin-top: clamp(0.75rem, 1.5vw, 1.5rem);
    }
  }
</style>
