---
// Encart honnête : ce qu'un vrai site afficherait à cet endroit (coordonnées, chantiers réels…).
interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}
const { tone = 'light', class: className } = Astro.props;
---

<div class:list={['note', `note--${tone}`, className]} role="note">
  <svg class="note__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true" focusable="false">
    <path d="M4 4.5h16v15H4z" stroke-dasharray="2.5 2" />
    <path d="M8 9.5h8M8 13h5.5" />
  </svg>
  <p><strong>Dans un vrai site :</strong> <slot /></p>
</div>

<style>
  .note {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.05rem 1.2rem;
    border: 1px dashed;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .note--light {
    color: var(--mo-ink-2);
    border-color: var(--mo-line-strong);
    background: rgb(250 246 239 / 0.72);
  }

  .note--dark {
    color: var(--mo-lime-dim);
    border-color: rgb(250 246 239 / 0.32);
    background: rgb(250 246 239 / 0.04);
  }

  .note strong {
    font-weight: 680;
    color: var(--mo-ink);
  }

  .note--dark strong {
    color: var(--mo-cream);
  }

  .note__icon {
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    margin-top: 0.1rem;
    color: var(--mo-terra-ink);
  }

  .note--dark .note__icon {
    color: var(--mo-ochre-light);
  }
</style>
