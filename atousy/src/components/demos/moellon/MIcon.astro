---
// Icônes au trait de la démo Moellon : héritent de currentColor, toujours décoratives.
interface Props {
  name: 'arrow' | 'arrow-down' | 'menu' | 'close' | 'chevron' | 'lock' | 'upload' | 'check';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class={className}
  width="1em"
  height="1em"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow' && <path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5" />}
  {name === 'arrow-down' && <path d="M12 4v15M6.5 13.5 12 19l5.5-5.5" />}
  {name === 'menu' && <path d="M4 8h16M4 16h11" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'chevron' && <path d="m6.5 9.5 5.5 5.5 5.5-5.5" />}
  {
    name === 'lock' && (
      <>
        <rect x="5" y="10.5" width="14" height="10" />
        <path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3" />
      </>
    )
  }
  {name === 'upload' && <path d="M12 15V4M7.5 8.5 12 4l4.5 4.5M4.5 14.5V20h15v-5.5" />}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
</svg>
