---
// Pied de page Moellon : marque, navigation, savoir-faire, encart « dans un vrai site », mention fictive.
import Logo from './Logo.astro';
import RealSiteNote from './RealSiteNote.astro';
import StoneCourse from './StoneCourse.astro';
import { moellonNav, moellonCrafts } from './nav';
---

<footer class="footer mo-dark">
  <StoneCourse class="footer__course" />
  <div class="mo-container">
    <div class="top">
      <div class="brand">
        <a class="brand__link" href="/exemples/moellon/" aria-label="Moellon, accueil">
          <Logo tone="light" size="lg" />
        </a>
        <p class="brand__tagline">Rénover la pierre, bâtir pour durer.</p>
        <p class="brand__text">Maçonnerie, extensions, ouvertures et rénovation de maisons anciennes, autour de chez vous.</p>
      </div>

      <nav class="col" aria-label="Pied de page">
        <p class="col__title">Le site</p>
        <ul>
          {moellonNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="col">
        <p class="col__title">Savoir-faire</p>
        <ul>
          {moellonCrafts.map((c) => <li><a href={`/exemples/moellon/savoir-faire/#${c.id}`}>{c.label}</a></li>)}
        </ul>
      </div>

      <div class="col col--info">
        <p class="col__title">Nous joindre</p>
        <RealSiteNote tone="dark">vos coordonnées, vos horaires, votre zone d’intervention et vos qualifications réelles.</RealSiteNote>
      </div>
    </div>

    <div class="bottom">
      <p>Moellon est une entreprise fictive. Ce site est une démonstration conçue par Atousy, studio web &amp; design.</p>
      <a href="/exemples/">Voir les autres démonstrations</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-bottom: 2rem;
  }

  .footer :global(.footer__course) {
    margin-bottom: clamp(3rem, 6vw, 4.75rem);
    opacity: 0.9;
  }

  .top {
    display: grid;
    grid-template-columns: 1.4fr 0.75fr 1.15fr 1.1fr;
    gap: 2.75rem clamp(2rem, 4vw, 4rem);
  }

  .brand__link {
    display: flex;
    width: fit-content;
    color: var(--mo-cream);
    text-decoration: none;
  }

  .brand__tagline {
    margin-top: 1.5rem;
    font-family: var(--mo-serif);
    font-size: 1.45rem;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--mo-cream);
  }

  .brand__text {
    max-width: 34ch;
    margin-top: 0.6rem;
    font-size: 0.9375rem;
    color: var(--mo-lime-dim);
  }

  .col__title {
    margin-bottom: 1.1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--mo-line-light);
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mo-ochre-light);
  }

  .col ul {
    display: grid;
    gap: 0.3rem;
    padding: 0;
    list-style: none;
  }

  .col a {
    display: inline-block;
    padding-block: 0.2rem;
    color: var(--mo-lime);
    text-decoration: none;
  }

  .col a:hover {
    color: var(--mo-cream);
    text-decoration: underline;
    text-decoration-color: var(--mo-ochre-light);
    text-underline-offset: 0.3em;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--mo-line-light);
    font-size: 0.875rem;
    color: var(--mo-lime-dim);
  }

  .bottom a {
    display: inline-block;
    padding-block: 0.25rem;
    color: var(--mo-cream);
    font-weight: 600;
    text-decoration-color: var(--mo-ochre-light);
    text-underline-offset: 0.3em;
  }

  @media (max-width: 64em) {
    .top {
      grid-template-columns: 1fr 1fr;
    }

    .brand,
    .col--info {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 34em) {
    .top {
      grid-template-columns: 1fr;
    }
  }
</style>
