---
// Encart honnête : ce qu'un vrai site afficherait à cet endroit (coordonnées, chantiers réels…).
interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}
const { tone = 'light', class: className } = Astro.props;
---

<div class:list={['note', `note--${tone}`, className]} role="note">
  <svg class="note__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false">
    <path d="M3 11.5 12 4l9 7.5" />
    <path d="M5.5 10v10h13V10" />
    <path d="M10 20v-5h4v5" />
  </svg>
  <p><strong>Dans un vrai site :</strong> <slot /></p>
</div>

<style>
  .note {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.1rem 1.25rem;
    border: 1px dashed currentColor;
    border-left-width: 3px;
    border-left-style: solid;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .note--light {
    color: var(--ft-ink-2);
    border-color: var(--ft-line-strong);
    border-left-color: var(--ft-wood);
    background: rgb(251 249 245 / 0.7);
  }

  .note--dark {
    color: rgb(251 249 245 / 0.8);
    border-color: rgb(251 249 245 / 0.3);
    border-left-color: var(--ft-wood-light);
  }

  .note strong {
    font-weight: 650;
    color: var(--ft-ink);
  }

  .note--dark strong {
    color: var(--ft-white);
  }

  .note__icon {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.1rem;
    color: var(--ft-wood-ink);
  }

  .note--dark .note__icon {
    color: var(--ft-wood-light);
  }
</style>
