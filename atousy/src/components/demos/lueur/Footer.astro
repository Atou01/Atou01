---
// Pied de page Lueur : marque, navigation, prestations, encart « dans un vrai site », mention fictive.
import Logo from './Logo.astro';
import RealSiteNote from './RealSiteNote.astro';
import { lueurNav, lueurServices } from './nav';
---

<footer class="footer">
  <div class="lu-container">
    <div class="top">
      <div class="brand">
        <a class="brand__link" href="/exemples/lueur/" aria-label="Lueur, accueil">
          <Logo size="lg" />
        </a>
        <p class="brand__tagline">Une maison bien éclairée, une installation sûre.</p>
        <p class="brand__text">Électricien pour les particuliers : rénovation, tableaux, éclairage, recharge et domotique, autour de chez vous.</p>
      </div>

      <nav class="col" aria-label="Pied de page">
        <p class="col__title">Le site</p>
        <ul>
          {lueurNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="col">
        <p class="col__title">Prestations</p>
        <ul>
          {lueurServices.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>

      <div class="col col--info">
        <p class="col__title">Nous joindre</p>
        <RealSiteNote tone="dark">vos coordonnées, vos horaires et votre zone d’intervention, avec un lien vers votre fiche d’établissement.</RealSiteNote>
      </div>
    </div>

    <div class="bottom">
      <p>Lueur est une entreprise fictive. Ce site est une démonstration conçue par Atousy, studio web &amp; design.</p>
      <a href="/exemples/">Voir les autres démonstrations</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: clamp(3.5rem, 7vw, 5.5rem) 2rem;
    background: var(--lu-deep);
    color: var(--lu-ivory);
    border-top: 1px solid var(--lu-line-dark);
  }

  .footer :global(:focus-visible) {
    outline-color: var(--lu-amber);
  }

  .top {
    display: grid;
    grid-template-columns: 1.4fr 0.7fr 1fr 1.15fr;
    gap: 2.75rem clamp(2rem, 4vw, 4rem);
  }

  .brand__link {
    display: inline-flex;
    color: var(--lu-ivory);
    text-decoration: none;
  }

  .brand__tagline {
    max-width: 22ch;
    margin-top: 1.5rem;
    font-size: 1.375rem;
    font-weight: 380;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--lu-ivory);
  }

  .brand__text {
    max-width: 36ch;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: var(--lu-dim);
  }

  .col__title {
    margin-bottom: 1.1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--lu-line-dark);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--lu-amber);
  }

  .col ul {
    display: grid;
    gap: 0.3rem;
    padding: 0;
    list-style: none;
  }

  .col a {
    display: inline-block;
    padding-block: 0.2rem;
    color: rgb(245 239 228 / 0.86);
    text-decoration: none;
  }

  .col a:hover {
    color: var(--lu-ivory);
    text-decoration: underline;
    text-decoration-color: var(--lu-amber);
    text-underline-offset: 0.3em;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--lu-line-dark);
    font-size: 0.875rem;
    color: var(--lu-dim);
  }

  .bottom a {
    display: inline-block;
    padding-block: 0.4rem;
    color: var(--lu-ivory);
    font-weight: 600;
    text-decoration-color: var(--lu-amber);
    text-underline-offset: 0.3em;
  }

  .bottom a:hover {
    color: var(--lu-amber);
  }

  @media (max-width: 64em) {
    .top {
      grid-template-columns: 1fr 1fr;
    }

    .brand,
    .col--info {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 32em) {
    .top {
      grid-template-columns: 1fr;
    }
  }
</style>
