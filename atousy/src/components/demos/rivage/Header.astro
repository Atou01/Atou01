---
// En-tête Rivage : logo, navigation, bouton contact.
// Mobile : bouton « Menu » (aria-expanded) qui ouvre un panneau ; Échap ferme et rend le focus.
// Sans JavaScript, la navigation reste visible (liens repliés sous le logo).
import Icon from '../../Icon.astro';
import Logo from './Logo.astro';
import { rivageNav, type RivagePage } from './nav';

interface Props {
  current: RivagePage;
}
const { current } = Astro.props;
---

<header class="header" data-rv-header>
  <div class="bar rv-container">
    <a class="brand" href="/exemples/rivage/" aria-label="Rivage, accueil" aria-current={current === 'accueil' ? 'page' : undefined}>
      <Logo />
    </a>

    <button class="burger" type="button" aria-expanded="false" aria-controls="rv-menu" data-rv-toggle hidden>
      <span class="burger__label">Menu</span>
      <span class="burger__icon" aria-hidden="true">
        <Icon name="menu" class="i-open" />
        <Icon name="close" class="i-close" />
      </span>
    </button>

    <nav id="rv-menu" class="nav" aria-label="Navigation principale">
      <ul class="nav__list">
        {
          rivageNav.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="rv-btn rv-btn--sm nav__cta" href="/exemples/rivage/contact/" aria-current={current === 'contact' ? 'page' : undefined}>
        Nous contacter
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.querySelector('[data-rv-header]');
    if (!header) return;
    var btn = header.querySelector('[data-rv-toggle]');
    var panel = document.getElementById('rv-menu');
    if (!btn || !panel) return;

    header.classList.add('is-enhanced');
    btn.hidden = false;

    function isOpen() {
      return btn.getAttribute('aria-expanded') === 'true';
    }
    function setOpen(open, returnFocus) {
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      header.classList.toggle('is-open', open);
      if (!open && returnFocus) btn.focus();
    }

    btn.addEventListener('click', function () {
      setOpen(!isOpen(), false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen()) setOpen(false, true);
    });
    document.addEventListener('click', function (e) {
      if (isOpen() && !header.contains(e.target)) setOpen(false, false);
    });
    header.addEventListener('focusout', function (e) {
      if (isOpen() && e.relatedTarget && !header.contains(e.relatedTarget)) setOpen(false, false);
    });
    panel.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('a')) setOpen(false, false);
    });
    var mq = window.matchMedia('(min-width: 56.01em)');
    var onChange = function (e) {
      if (e.matches) setOpen(false, false);
    };
    if (mq.addEventListener) mq.addEventListener('change', onChange);
  })();
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(246 241 230 / 0.94);
    border-bottom: 1px solid var(--rv-line);
  }

  @supports (backdrop-filter: blur(8px)) {
    .header {
      background: rgb(246 241 230 / 0.82);
      backdrop-filter: saturate(1.2) blur(12px);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.75rem;
  }

  .brand {
    display: inline-flex;
    margin-right: auto;
    padding-block: 0.4rem;
    text-decoration: none;
    border-radius: 3px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.75rem);
  }

  .nav__list {
    display: flex;
    gap: clamp(1.25rem, 2.6vw, 2.5rem);
    padding: 0;
    list-style: none;
  }

  .nav__list a {
    position: relative;
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--rv-ink);
    font-size: 0.9688rem;
    font-weight: 500;
    text-decoration: none;
  }

  .nav__list a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.2rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--rv-ease);
  }

  .nav__list a:hover::after,
  .nav__list a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav__list a[aria-current='page'] {
    color: var(--rv-green);
  }

  .burger {
    display: none;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0 0.35rem 0 0.9rem;
    background: transparent;
    border: 1px solid rgb(30 51 40 / 0.22);
    border-radius: 999px;
    color: var(--rv-green);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
  }

  .burger__icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    background: var(--rv-green);
    color: var(--rv-ivory);
    border-radius: 50%;
  }

  .burger__icon :global(svg) {
    grid-area: 1 / 1;
    width: 1.05rem;
    height: 1.05rem;
  }

  .burger :global(.i-close),
  .is-open .burger :global(.i-open) {
    display: none;
  }

  .is-open .burger :global(.i-close) {
    display: block;
  }

  @media (max-width: 56em) {
    .bar {
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
      min-height: 4rem;
    }

    /* Sans JavaScript : liens visibles, repliés sous le logo, en-tête non collant */
    .header:not(.is-enhanced) {
      position: relative;
    }

    .nav {
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
      width: 100%;
      padding-bottom: 0.75rem;
    }

    .nav__list {
      flex-wrap: wrap;
      gap: 0.25rem 1.25rem;
    }

    /* Avec JavaScript : panneau déroulant */
    .is-enhanced .burger:not([hidden]) {
      display: inline-flex;
    }

    .is-enhanced .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 1.75rem;
      width: auto;
      max-height: calc(100svh - 4rem);
      overflow-y: auto;
      padding: 1.5rem var(--rv-gutter) 2rem;
      background: var(--rv-ivory);
      border-bottom: 1px solid var(--rv-line);
      box-shadow: 0 24px 40px -24px rgb(20 35 28 / 0.35);
    }

    .is-enhanced.is-open .nav {
      display: flex;
    }

    .is-enhanced .nav__list {
      flex-direction: column;
      gap: 0;
    }

    .is-enhanced .nav__list li + li {
      border-top: 1px solid var(--rv-line);
    }

    .is-enhanced .nav__list a {
      display: block;
      padding-block: 0.95rem;
      font-family: var(--rv-serif);
      font-size: 1.75rem;
      font-weight: 400;
      letter-spacing: -0.01em;
      color: var(--rv-green);
    }

    .is-enhanced .nav__list a::after {
      display: none;
    }

    .is-enhanced .nav__list a[aria-current='page'] {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.25em;
    }

    .is-enhanced .nav__cta {
      justify-content: center;
      padding-block: 1rem;
      font-size: 1rem;
    }
  }
</style>
