---
// Introduction des pages intérieures : fil d'Ariane, H1, chapeau, image optionnelle (image « hero » de la page).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  lead: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
}
const { title, lead, image, imageAlt = '', imagePosition = '50% 50%' } = Astro.props;
---

<section class="intro" aria-labelledby="page-title">
  <div class="rv-container">
    <nav class="crumbs" aria-label="Fil d’Ariane">
      <ol>
        <li><a href="/exemples/rivage/">Accueil</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>

    <div class="head">
      <h1 id="page-title">{title}</h1>
      <div class="aside">
        <p class="rv-lead">{lead}</p>
        <slot />
      </div>
    </div>
  </div>

  {
    image && (
      <div class="rv-container">
        <div class="media" style={`--pos: ${imagePosition}`}>
          <Picture
            src={image}
            alt={imageAlt}
            formats={['avif', 'webp']}
            widths={[640, 960, 1280, 1600, 2200]}
            sizes="(max-width: 80em) calc(100vw - 2.5rem), 77rem"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    )
  }
</section>

<style>
  .intro {
    padding-top: clamp(2rem, 4vw, 3.25rem);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    color: var(--rv-ink-2);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    opacity: 0.6;
  }

  .crumbs a {
    color: var(--rv-ink-2);
    text-underline-offset: 0.25em;
  }

  .crumbs a:hover {
    color: var(--rv-green);
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: end;
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
    padding-block: clamp(2.25rem, 5vw, 4.25rem) clamp(2.5rem, 5vw, 4rem);
  }

  h1 {
    font-size: clamp(3rem, 1.6rem + 5.4vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.028em;
  }

  .aside {
    display: grid;
    gap: 1.5rem;
    max-width: 34rem;
    padding-bottom: 0.4rem;
  }

  .media {
    overflow: hidden;
    aspect-ratio: 2.35;
    border-radius: var(--rv-radius);
    background: var(--rv-ivory-2);
  }

  .media :global(picture) {
    display: block;
    height: 100%;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
  }

  @media (max-width: 56em) {
    .head {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .media {
      aspect-ratio: 4 / 3;
    }
  }
</style>
