---
// Pied de page Rivage : marque, navigation, encart « dans un vrai site », mention fictive.
import Logo from './Logo.astro';
import RealSiteNote from './RealSiteNote.astro';
import { rivageNav } from './nav';
---

<footer class="footer rv-dark">
  <div class="rv-container">
    <div class="top">
      <div class="brand">
        <a class="brand__link" href="/exemples/rivage/" aria-label="Rivage, accueil">
          <Logo tone="ivory" size="lg" />
        </a>
        <p class="brand__tagline">Des paysages pour vivre dehors.<br /> En toute saison.</p>
      </div>

      <nav class="links" aria-label="Pied de page">
        <p class="links__title">Le jardin</p>
        <ul>
          <li><a href="/exemples/rivage/">Accueil</a></li>
          {rivageNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/exemples/rivage/contact/">Nous contacter</a></li>
        </ul>
      </nav>

      <div class="info">
        <p class="links__title">Nous trouver</p>
        <RealSiteNote tone="dark">vos coordonnées, horaires et zone d’intervention.</RealSiteNote>
      </div>
    </div>

    <div class="bottom">
      <p>Rivage est une entreprise fictive. Ce site est une démonstration conçue par Atousy, studio web &amp; design.</p>
      <a href="/exemples/">Voir les autres démonstrations</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(3.5rem, 7vw, 5.5rem) 2rem;
    background: var(--rv-green);
    color: var(--rv-ivory);
  }

  .top {
    display: grid;
    grid-template-columns: 1.3fr 0.8fr 1.1fr;
    gap: 2.5rem clamp(2rem, 5vw, 5rem);
  }

  .brand__link {
    display: inline-flex;
    text-decoration: none;
    border-radius: 3px;
  }

  .brand__tagline {
    margin-top: 1.25rem;
    font-family: var(--rv-serif);
    font-size: 1.375rem;
    font-style: italic;
    font-weight: 350;
    line-height: 1.35;
    color: rgb(246 241 230 / 0.86);
  }

  .links__title {
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rv-wheat);
  }

  .links ul {
    display: grid;
    gap: 0.55rem;
    padding: 0;
    list-style: none;
  }

  .links a {
    color: var(--rv-ivory);
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid rgb(246 241 230 / 0.16);
    font-size: 0.875rem;
    color: rgb(246 241 230 / 0.78);
  }

  .bottom a {
    color: var(--rv-ivory);
    font-weight: 600;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 56em) {
    .top {
      grid-template-columns: 1fr 1fr;
    }

    .brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 34em) {
    .top {
      grid-template-columns: 1fr;
    }
  }
</style>
