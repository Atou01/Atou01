---
// Encart honnête : ce qu'un vrai site afficherait à cet endroit (coordonnées, réalisations…).
interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}
const { tone = 'light', class: className } = Astro.props;
---

<div class:list={['note', `note--${tone}`, className]} role="note">
  <svg class="note__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <rect x="3.5" y="4.5" width="17" height="15" rx="2" />
    <path d="M3.5 9h17M7 6.8h.01M9.5 6.8h.01" />
  </svg>
  <p><strong>Dans un vrai site :</strong> <slot /></p>
</div>

<style>
  .note {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.1rem 1.25rem;
    border: 1px dashed currentColor;
    border-radius: var(--rv-radius);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .note--light {
    color: var(--rv-ink-2);
    border-color: rgb(30 51 40 / 0.35);
    background: rgb(255 255 255 / 0.45);
  }

  .note--dark {
    color: rgb(246 241 230 / 0.82);
    border-color: rgb(246 241 230 / 0.35);
  }

  .note strong {
    font-weight: 650;
    color: var(--rv-ink);
  }

  .note--dark strong {
    color: var(--rv-ivory);
  }

  .note__icon {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.1rem;
  }
</style>
