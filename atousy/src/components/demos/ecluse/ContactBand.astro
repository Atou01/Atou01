---
// Encart d'appel à l'action, en fin de page : panneau ardoise arrondi vers la page Contact.
import EIcon from './EIcon.astro';
import RealSiteNote from './RealSiteNote.astro';

interface Props {
  title?: string;
  text?: string;
  button?: string;
}
const {
  title = 'Une fuite, un projet, une question ?',
  text = 'Décrivez votre besoin en quelques lignes, avec une photo si vous le pouvez : nous revenons vers vous pour en parler.',
  button = 'Nous contacter',
} = Astro.props;
---

<section class="band-wrap" aria-labelledby="ec-band-title">
  <div class="ec-wide">
    <div class="band ec-dark">
      <svg class="band__deco" viewBox="0 0 320 220" fill="none" aria-hidden="true" focusable="false">
        <path d="M0 96h150v54h170" stroke="currentColor" stroke-width="2" />
        <path d="M0 126h150v54h170" stroke="currentColor" stroke-width="2" opacity="0.6" />
        <path d="M0 156h150v54h170" stroke="currentColor" stroke-width="2" opacity="0.35" />
        <path d="M150 20v200" stroke="currentColor" stroke-width="2" />
      </svg>
      <div class="band__text">
        <h2 id="ec-band-title" class="band__title">{title}</h2>
        <p>{text}</p>
      </div>
      <div class="band__actions">
        <a class="ec-btn ec-btn--brass" href="/exemples/ecluse/contact/">
          {button}
          <span class="ec-btn__icon"><EIcon name="arrow" /></span>
        </a>
        <RealSiteNote tone="dark">votre numéro de téléphone, cliquable sur mobile, et vos horaires de dépannage.</RealSiteNote>
      </div>
    </div>
  </div>
</section>

<style>
  .band-wrap {
    padding-block: clamp(1rem, 3vw, 2rem) clamp(3rem, 6vw, 5rem);
  }

  .band {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: 2rem clamp(2rem, 6vw, 6rem);
    padding: clamp(2.25rem, 6vw, 4.75rem) clamp(1.5rem, 6vw, 5rem);
    background: var(--ec-slate-deep);
    border-radius: var(--ec-radius-lg);
    overflow: hidden;
    isolation: isolate;
  }

  .band__deco {
    position: absolute;
    right: -2rem;
    top: -1rem;
    z-index: -1;
    width: clamp(14rem, 30vw, 22rem);
    color: rgb(220 195 148 / 0.22);
  }

  .band__title {
    max-width: 18ch;
    font-size: clamp(2rem, 1.3rem + 2.3vw, 3.1rem);
    color: var(--ec-white);
  }

  .band__text p {
    max-width: 48ch;
    margin-top: 1rem;
    font-size: 1.0938rem;
    color: rgb(255 255 255 / 0.84);
  }

  .band__actions {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }

  @media (max-width: 60em) {
    .band {
      grid-template-columns: 1fr;
    }
  }
</style>
