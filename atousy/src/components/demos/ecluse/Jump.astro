---
// Sommaire de page en pastilles (liens d'ancre « Sur cette page »).
interface Props {
  items: { href: string; label: string }[];
  label?: string;
}
const { items, label = 'Sur cette page' } = Astro.props;
---

<nav class="jump" aria-label={label}>
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .jump {
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    background: var(--ec-white);
    border: 1px solid var(--ec-line-strong);
    border-radius: 999px;
    color: var(--ec-ink);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.2s var(--ec-ease),
      border-color 0.2s var(--ec-ease),
      color 0.2s var(--ec-ease);
  }

  a:hover {
    background: var(--ec-slate);
    border-color: var(--ec-slate);
    color: var(--ec-white);
  }
</style>
