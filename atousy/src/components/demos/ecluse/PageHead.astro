---
// Ouverture des pages intérieures : panneau gris clair arrondi, fil d'Ariane, H1, chapeau
// et photo d'ouverture à droite (chargée en priorité) — ou, sans photo, un encart libre (slot « aside »).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  crumb: string;
  lead: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
  caption?: string;
}
const { title, crumb, lead, image, imageAlt = '', imagePosition = '50% 50%', caption } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="head" aria-labelledby="page-title">
  <div class="ec-wide">
    <div class:list={['panel', !image && 'panel--text']}>
      <div class="copy">
        <nav class="crumbs" aria-label="Fil d’Ariane">
          <ol>
            <li><a href="/exemples/ecluse/">Accueil</a></li>
            <li aria-current="page">{crumb}</li>
          </ol>
        </nav>
        <h1 id="page-title">{title}</h1>
        <p class="ec-lead">{lead}</p>
        <slot />
      </div>
      {
        image && (
          <figure class="media" style={`--pos: ${imagePosition}`}>
            <Picture
              src={image}
              alt={imageAlt}
              formats={['avif', 'webp']}
              widths={[560, 800, 1100, 1400]}
              sizes="(max-width: 60em) calc(100vw - 2rem), 44vw"
              loading="eager"
              fetchpriority="high"
            />
            {caption && <figcaption class="media__caption">{caption}</figcaption>}
          </figure>
        )
      }
      {
        !image && hasAside && (
          <div class="aside">
            <slot name="aside" />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .head {
    padding-top: clamp(1rem, 2.5vw, 1.75rem);
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding: clamp(0.6rem, 1vw, 0.75rem);
    background: var(--ec-mist);
    border: 1px solid var(--ec-line);
    border-radius: var(--ec-radius-lg);
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(1.5rem, 5vw, 4.5rem) clamp(1rem, 4vw, 3.5rem);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ec-ink);
  }

  .crumbs li + li::before {
    content: '';
    width: 0.35rem;
    height: 0.35rem;
    border-top: 1.5px solid var(--ec-ink-3);
    border-right: 1.5px solid var(--ec-ink-3);
    transform: rotate(45deg);
  }

  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    color: var(--ec-ink-2);
    text-decoration: underline;
    text-decoration-color: var(--ec-line-strong);
    text-underline-offset: 0.3em;
  }

  .crumbs a:hover {
    color: var(--ec-ink);
    text-decoration-color: var(--ec-brass);
  }

  h1 {
    max-width: 16ch;
    font-size: clamp(2.5rem, 1.5rem + 3.6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .ec-lead {
    max-width: 36rem;
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .media {
    position: relative;
    min-height: 26rem;
    border-radius: calc(var(--ec-radius-lg) - 0.6rem);
    overflow: hidden;
    background: var(--ec-mist-2);
  }

  .media :global(picture) {
    position: absolute;
    inset: 0;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
  }

  .media__caption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.45rem 0.85rem;
    background: rgb(255 255 255 / 0.94);
    border-radius: 999px;
    color: var(--ec-ink);
    font-size: 0.8125rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .panel--text {
    align-items: end;
  }

  .aside {
    align-self: end;
    padding: clamp(1rem, 4vw, 3.5rem) clamp(0.5rem, 3vw, 3rem) clamp(1rem, 4vw, 3.5rem) 0;
  }

  @media (max-width: 60em) {
    .panel {
      grid-template-columns: 1fr;
    }

    .aside {
      padding: 0 0.9rem 1.25rem;
    }

    .copy {
      padding: 1.5rem 0.9rem 0.5rem;
    }

    .media {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }
  }

  /* Tablette : photo plus panoramique, pour ne pas repousser le contenu trop loin */
  @media (min-width: 40.01em) and (max-width: 60em) {
    .media {
      aspect-ratio: 16 / 9;
    }
  }
</style>
