---
// Logo Écluse : pictogramme d'écluse (deux niveaux d'eau séparés par une porte) dans un carré arrondi
// ardoise, + mot-symbole « écluse » en minuscules, Figtree très gras.
interface Props {
  size?: 'md' | 'lg';
}
const { size = 'md' } = Astro.props;
---

<span class:list={['logo', `logo--${size}`]}>
  <svg class="logo__glyph" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
    <rect x="0.5" y="0.5" width="27" height="27" rx="8" fill="var(--ec-slate)" />
    <path d="M5 12h8.25v5H23v3.5a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3z" fill="var(--ec-brass)" />
    <path d="M13.25 5.5v18" stroke="#fff" stroke-width="2" stroke-linecap="round" />
  </svg>
  <span class="logo__word">écluse</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    line-height: 1;
    color: var(--ec-ink);
  }

  .logo__glyph {
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
  }

  .logo__word {
    font-family: var(--ec-sans);
    font-size: 1.625rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    /* compense la hampe du « l » pour centrer optiquement sur le pictogramme */
    transform: translateY(-0.04em);
  }

  .logo--lg .logo__glyph {
    width: 2.25rem;
    height: 2.25rem;
  }

  .logo--lg .logo__word {
    font-size: 2.125rem;
  }
</style>
