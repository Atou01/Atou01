---
// Pictogrammes Écluse : trait fin arrondi, héritent de currentColor. Décoratifs (aria-hidden).
export type EIconName =
  | 'arrow'
  | 'chevron'
  | 'menu'
  | 'close'
  | 'check'
  | 'wrench'
  | 'shower'
  | 'flame'
  | 'heatpump'
  | 'calendar'
  | 'chat'
  | 'clipboard'
  | 'home'
  | 'drop'
  | 'gauge'
  | 'lock'
  | 'upload'
  | 'info';

interface Props {
  name: EIconName;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class={className}
  width="1em"
  height="1em"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow' && <path d="M4.5 12h15M13.5 6l6 6-6 6" />}
  {name === 'chevron' && <path d="m6 9 6 6 6-6" />}
  {name === 'menu' && <path d="M4 8h16M4 16h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {
    name === 'wrench' && (
      <path d="M14.6 3.6a5 5 0 0 0-5.5 6.9l-5.4 5.4a2.1 2.1 0 0 0 3 3l5.4-5.4a5 5 0 0 0 6.9-5.5l-3 3-2.6-.8-.8-2.6 3-3z" />
    )
  }
  {
    name === 'shower' && (
      <>
        <path d="M5 21V7.5A3.5 3.5 0 0 1 8.5 4h.5a3.5 3.5 0 0 1 3.5 3.5V9" />
        <path d="M9 9h7" />
        <path d="M10.5 13v.5M13.5 13v.5M16.5 13v.5M12 17v.5M15 17v.5M18 17v.5" />
      </>
    )
  }
  {
    name === 'flame' && (
      <path d="M12 21a6 6 0 0 0 6-6c0-4-2.6-6.4-4.2-10-1.4 1.9-1.9 3.6-1.8 5.2-1-.6-1.7-1.6-2-3C8 9 6 11.6 6 15a6 6 0 0 0 6 6z" />
    )
  }
  {
    name === 'heatpump' && (
      <>
        <rect x="2.5" y="5" width="19" height="13" rx="2.2" />
        <circle cx="9.5" cy="11.5" r="4" />
        <path d="M9.5 9.5v4M7.5 11.5h4" />
        <path d="M16 9h2.5M16 11.5h2.5M16 14h2.5M6 18v1.5M18 18v1.5" />
      </>
    )
  }
  {
    name === 'calendar' && (
      <>
        <rect x="3.5" y="5" width="17" height="15.5" rx="2.5" />
        <path d="M8 3v4M16 3v4M3.5 10h17" />
        <path d="m9 15.2 2 2 4-4" />
      </>
    )
  }
  {
    name === 'chat' && (
      <>
        <path d="M5 4.5h14a2 2 0 0 1 2 2V15a2 2 0 0 1-2 2h-7l-4.5 3.5V17H5a2 2 0 0 1-2-2V6.5a2 2 0 0 1 2-2z" />
        <path d="M7.5 9.5h9M7.5 12.5h5.5" />
      </>
    )
  }
  {
    name === 'clipboard' && (
      <>
        <rect x="4.5" y="4.5" width="15" height="16.5" rx="2.2" />
        <path d="M9 4.5V3h6v1.5" />
        <path d="M8.5 10h7M8.5 13.5h7M8.5 17h4" />
      </>
    )
  }
  {
    name === 'home' && (
      <>
        <path d="M3.5 11 12 4l8.5 7" />
        <path d="M5.5 9.5V20h13V9.5" />
        <path d="M10 20v-5.5h4V20" />
      </>
    )
  }
  {name === 'drop' && <path d="M12 3.5c3 3.8 6 7 6 10.5a6 6 0 0 1-12 0c0-3.5 3-6.7 6-10.5z" />}
  {
    name === 'gauge' && (
      <>
        <path d="M4.6 17.5a8.5 8.5 0 1 1 14.8 0" />
        <path d="m12 13.5 4-4" />
        <circle cx="12" cy="13.5" r="1.3" />
      </>
    )
  }
  {
    name === 'lock' && (
      <>
        <rect x="5" y="10.5" width="14" height="10" rx="2" />
        <path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3" />
      </>
    )
  }
  {
    name === 'upload' && (
      <path d="M12 15V4M7.5 8.5 12 4l4.5 4.5M4.5 14.5v4a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5v-4" />
    )
  }
  {
    name === 'info' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 11v5.5M12 7.8v.2" />
      </>
    )
  }
</svg>
