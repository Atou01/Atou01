---
import { mainNav } from '../data/site';
import Icon from './Icon.astro';
import MarketSelect from './MarketSelect.astro';

interface Props {
  /** En-tête transparent posé sur le hero (page d'accueil, grand écran). */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-site-header>
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/">
      <img src="/brand/atousy-logo-complet.svg" width="150" height="66" alt="Atousy, studio web & design — accueil" />
    </a>

    {/* Avant la navigation : au clavier, le bouton précède le menu qu'il ouvre et reste en haut à l'ouverture. */}
    <button class="menu-toggle js-only" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="menu-toggle__open"><Icon name="menu" /></span>
      <span class="menu-toggle__close"><Icon name="close" /></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Navigation principale">
      <ul class="site-nav__list">
        {
          mainNav.map((item) =>
            item.children ? (
              <li class="site-nav__item site-nav__item--group" data-submenu>
                <button class="site-nav__link site-nav__toggle" type="button" aria-expanded="false" aria-controls="submenu-services">
                  {item.label}
                  <Icon name="chevron" class="site-nav__chevron" />
                </button>
                <span class="site-nav__group-label">
                  {item.label}
                </span>
                <ul class="site-nav__sub" id="submenu-services">
                  {item.children.map((child) => (
                    <li>
                      <a class="site-nav__sublink" href={child.href} aria-current={isCurrent(child.href) ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="site-nav__item">
                <a class="site-nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <div class="site-nav__mobile-extra">
        <MarketSelect id="market-menu" />
        <a class="btn btn--dark" href="/devis/">Demander un devis <Icon name="arrow" /></a>
      </div>
    </nav>

    <div class="site-header__actions">
      <MarketSelect id="market-header" />
      <a class="btn btn--dark btn--sm" href="/devis/">Demander un devis</a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = header?.querySelector<HTMLElement>('#site-nav');
  const group = header?.querySelector<HTMLElement>('[data-submenu]');
  const groupBtn = group?.querySelector<HTMLButtonElement>('.site-nav__toggle');
  const desktop = window.matchMedia('(min-width: 62.5em)');

  const setMenu = (open: boolean) => {
    header?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('menu-open', open);
  };

  // Sous-menu « Services » (grand écran). Son affichage dépend uniquement de .is-open,
  // tenu à jour avec aria-expanded. Ouvert au survol, il se referme quand la souris sort ;
  // ouvert au clic ou au clavier, il reste ouvert jusqu'à Échap, un clic ailleurs ou la sortie du focus.
  let openedByHover = false;
  let closeTimer: number | undefined;
  const setSub = (open: boolean, byHover = false) => {
    window.clearTimeout(closeTimer);
    openedByHover = open && byHover;
    group?.classList.toggle('is-open', open);
    groupBtn?.setAttribute('aria-expanded', String(open));
  };
  const subOpen = () => group?.classList.contains('is-open') ?? false;

  toggle?.addEventListener('click', () => setMenu(!header?.classList.contains('is-open')));

  groupBtn?.addEventListener('click', () => {
    // Ouvert par le survol : le clic le garde ouvert au lieu de le refermer.
    if (subOpen() && openedByHover) setSub(true);
    else setSub(!subOpen());
  });

  group?.addEventListener('pointerenter', (e) => {
    if (e.pointerType !== 'mouse' || !desktop.matches) return;
    window.clearTimeout(closeTimer);
    if (!subOpen()) setSub(true, true);
  });
  group?.addEventListener('pointerleave', (e) => {
    if (e.pointerType !== 'mouse' || !openedByHover) return;
    // Focus déjà dans le sous-menu (Tab après le survol) : il reste ouvert.
    if (group.contains(document.activeElement) && document.activeElement !== groupBtn) {
      openedByHover = false;
      return;
    }
    closeTimer = window.setTimeout(() => setSub(false), 150);
  });
  group?.addEventListener('focusout', (e) => {
    const next = e.relatedTarget as Node | null;
    if (next ? group.contains(next) : group.matches(':hover')) return;
    setSub(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (subOpen()) {
      const focusInside = group?.contains(document.activeElement);
      setSub(false);
      if (focusInside) groupBtn?.focus();
    } else if (header?.classList.contains('is-open')) {
      setMenu(false);
      toggle?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (group && !group.contains(e.target as Node)) setSub(false);
  });

  // Changement de taille d'écran : tout se referme. Si l'élément qui avait le focus
  // disparaît (bouton Menu en grand écran, liens du menu en petit écran), le focus va
  // sur l'élément qui le remplace au même endroit.
  desktop.addEventListener('change', () => {
    const active = document.activeElement as HTMLElement | null;
    setMenu(false);
    setSub(false);
    if (!active || !header?.contains(active) || active.getClientRects().length > 0) return;
    const target = desktop.matches ? nav?.querySelector<HTMLElement>('.site-nav__link') : toggle;
    target?.focus();
  });

  // Retour arrière depuis le cache du navigateur : la page revient avec le menu fermé.
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    setMenu(false);
    setSub(false);
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 30;
    background: var(--ivory);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: var(--header-h);
  }

  .site-header__logo {
    flex: none;
    display: block;
    border-radius: var(--radius);
  }

  .site-header__logo img {
    width: clamp(7.5rem, 10.5vw, 9.4rem);
    height: auto;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.6vw, 2.6rem);
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15rem;
    height: 2px;
    background: var(--coral);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current='page']::after,
  .site-nav__item--group:has([aria-current='page']) .site-nav__toggle::after {
    transform: scaleX(1);
  }

  .site-nav__toggle :global(.site-nav__chevron) {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 0.2s var(--ease);
  }

  .site-nav__item--group {
    position: relative;
  }

  .site-nav__group-label {
    display: none;
  }

  .site-nav__sub {
    position: absolute;
    top: 100%;
    left: -1rem;
    min-width: 13rem;
    padding: 0.5rem;
    list-style: none;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 18px 40px -18px rgb(15 35 41 / 0.35);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 0.18s var(--ease),
      transform 0.18s var(--ease),
      visibility 0.18s;
  }

  /* Avec JavaScript, seul .is-open (synchronisé avec aria-expanded) affiche le sous-menu ;
     sans JavaScript, le survol et le focus clavier prennent le relais. */
  .site-nav__item--group.is-open .site-nav__sub,
  :global(html:not(.js)) .site-nav__item--group:hover .site-nav__sub,
  :global(html:not(.js)) .site-nav__item--group:focus-within .site-nav__sub {
    opacity: 1;
    visibility: visible;
    transform: none;
    /* À l'ouverture, les liens sont atteignables tout de suite au clavier (pas d'attente sur visibility). */
    transition-property: opacity, transform;
  }

  .site-nav__item--group.is-open :global(.site-nav__chevron) {
    transform: rotate(180deg);
  }

  .site-nav__sublink {
    display: block;
    padding: 0.65rem 0.8rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius);
  }

  .site-nav__sublink:hover,
  .site-nav__sublink[aria-current='page'] {
    background: var(--ivory);
  }

  /* Page en cours : texte encre (le corail ne contraste pas assez en petit corps), soulignement corail. */
  .site-nav__sublink[aria-current='page'] {
    text-decoration: underline 2px var(--coral);
    text-underline-offset: 0.35em;
  }

  .site-nav__mobile-extra {
    display: none;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-left: auto;
  }

  .site-header__actions .btn {
    white-space: nowrap;
  }

  .menu-toggle {
    display: none;
  }

  /* Grand écran : navigation centrée, en-tête posé sur le hero */
  @media (min-width: 62.5em) {
    .site-nav {
      margin-left: clamp(2rem, 11vw, 12.5rem);
    }

    .site-header--overlay {
      position: absolute;
      inset: 0 0 auto;
      background: transparent;
    }
  }

  /* De 1000 à 1440 px, la marge de la navigation se réduit pour que tout tienne sur une ligne
     (même valeur que ci-dessus à 1440 px). */
  @media (min-width: 62.5em) and (max-width: 89.99em) {
    .site-nav {
      margin-left: clamp(1.5rem, 30.5vw - 17.5rem, 9.9rem);
    }
  }

  /* Téléphone et tablette : menu déroulant */
  @media (max-width: 62.49em) {
    .site-header__inner {
      min-height: 4.5rem;
      flex-wrap: wrap;
      gap: 0 1rem;
    }

    .site-header__actions {
      display: none;
    }

    .menu-toggle {
      display: inline-grid;
      place-items: center;
      width: 2.9rem;
      height: 2.9rem;
      /* 2,9rem + 2 × 0,8rem = 4,5rem : la première ligne garde la même hauteur,
         menu ouvert ou fermé, et le logo ne bouge pas. */
      margin-block: 0.8rem;
      margin-left: auto;
      margin-right: -0.5rem;
      padding: 0;
      border: 0;
      background: none;
      border-radius: var(--radius);
      cursor: pointer;
    }

    .menu-toggle :global(svg) {
      width: 1.6rem;
      height: 1.6rem;
    }

    .menu-toggle__close,
    .site-header.is-open .menu-toggle__open {
      display: none;
    }

    .site-header.is-open .menu-toggle__close {
      display: block;
    }

    .site-nav {
      flex-basis: 100%;
      padding: 0.5rem 0 1.5rem;
    }

    :global(html.js) .site-nav {
      display: none;
    }

    :global(html.js) .site-header.is-open .site-nav {
      display: block;
      max-height: calc(100dvh - 4.5rem);
      overflow-y: auto;
    }

    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .site-nav__item {
      border-bottom: 1px solid var(--line);
    }

    .site-nav__link,
    .site-nav__group-label {
      display: flex;
      width: 100%;
      padding: 1rem 0;
      font-size: 1.375rem;
      font-weight: 650;
      letter-spacing: -0.02em;
    }

    .site-nav__link::after {
      display: none;
    }

    .site-nav__link[aria-current='page'] {
      text-decoration: underline 2px var(--coral);
      text-underline-offset: 0.3em;
    }

    .site-nav__toggle {
      display: none;
    }

    .site-nav__group-label {
      padding-bottom: 0.25rem;
    }

    .site-nav__sub {
      position: static;
      min-width: 0;
      padding: 0 0 0.75rem;
      background: none;
      border: 0;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .site-nav__sublink {
      padding: 0.55rem 0;
      font-size: 1.0625rem;
      color: var(--ink-2);
    }

    .site-nav__sublink:hover {
      background: none;
      color: var(--ink);
    }

    .site-nav__sublink[aria-current='page'] {
      color: var(--ink);
    }

    .site-nav__mobile-extra {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding-top: 1.25rem;
    }

    .site-nav__mobile-extra .btn {
      flex: 1 1 14rem;
    }
  }
</style>
