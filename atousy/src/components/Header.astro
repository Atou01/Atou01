---
import { mainNav } from '../data/site';
import Icon from './Icon.astro';
import MarketSelect from './MarketSelect.astro';

interface Props {
  /** En-tête transparent posé sur le hero (page d'accueil, grand écran). */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-site-header>
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/">
      <img src="/brand/atousy-logo-complet.svg" width="150" height="66" alt="Atousy, studio web & design — accueil" />
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Navigation principale">
      <ul class="site-nav__list">
        {
          mainNav.map((item) =>
            item.children ? (
              <li class="site-nav__item site-nav__item--group" data-submenu>
                <button class="site-nav__link site-nav__toggle" type="button" aria-expanded="false" aria-controls="submenu-services">
                  {item.label}
                  <Icon name="chevron" class="site-nav__chevron" />
                </button>
                <span class="site-nav__group-label" aria-hidden="true">
                  {item.label}
                </span>
                <ul class="site-nav__sub" id="submenu-services">
                  {item.children.map((child) => (
                    <li>
                      <a class="site-nav__sublink" href={child.href} aria-current={isCurrent(child.href) ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="site-nav__item">
                <a class="site-nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <div class="site-nav__mobile-extra">
        <MarketSelect id="market-menu" />
        <a class="btn btn--dark" href="/devis/">Demander un devis <Icon name="arrow" /></a>
      </div>
    </nav>

    <div class="site-header__actions">
      <MarketSelect id="market-header" />
      <a class="btn btn--dark btn--sm" href="/devis/">Demander un devis</a>
    </div>

    <button class="menu-toggle js-only" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="menu-toggle__open"><Icon name="menu" /></span>
      <span class="menu-toggle__close"><Icon name="close" /></span>
      <span class="visually-hidden">Menu</span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const group = header?.querySelector<HTMLElement>('[data-submenu]');
  const groupBtn = group?.querySelector<HTMLButtonElement>('.site-nav__toggle');

  const setMenu = (open: boolean) => {
    header?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('menu-open', open);
  };
  const setSub = (open: boolean) => {
    group?.classList.toggle('is-open', open);
    groupBtn?.setAttribute('aria-expanded', String(open));
  };

  toggle?.addEventListener('click', () => setMenu(!header?.classList.contains('is-open')));
  groupBtn?.addEventListener('click', () => setSub(!group?.classList.contains('is-open')));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (group?.classList.contains('is-open')) {
      setSub(false);
      groupBtn?.focus();
    } else if (header?.classList.contains('is-open')) {
      setMenu(false);
      toggle?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (group && !group.contains(e.target as Node)) setSub(false);
  });
  window.matchMedia('(min-width: 62.5em)').addEventListener('change', () => setMenu(false));
</script>

<style>
  .site-header {
    position: relative;
    z-index: 30;
    background: var(--ivory);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: var(--header-h);
  }

  .site-header__logo {
    flex: none;
    display: block;
    border-radius: var(--radius);
  }

  .site-header__logo img {
    width: clamp(7.5rem, 10.5vw, 9.4rem);
    height: auto;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.6vw, 2.6rem);
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15rem;
    height: 2px;
    background: var(--coral);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current='page']::after,
  .site-nav__item--group:has([aria-current='page']) .site-nav__toggle::after {
    transform: scaleX(1);
  }

  .site-nav__toggle :global(.site-nav__chevron) {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 0.2s var(--ease);
  }

  .site-nav__item--group {
    position: relative;
  }

  .site-nav__group-label {
    display: none;
  }

  .site-nav__sub {
    position: absolute;
    top: 100%;
    left: -1rem;
    min-width: 13rem;
    padding: 0.5rem;
    list-style: none;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 18px 40px -18px rgb(15 35 41 / 0.35);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 0.18s var(--ease),
      transform 0.18s var(--ease),
      visibility 0.18s;
  }

  .site-nav__item--group:hover .site-nav__sub,
  .site-nav__item--group:focus-within .site-nav__sub,
  .site-nav__item--group.is-open .site-nav__sub {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .site-nav__item--group.is-open :global(.site-nav__chevron) {
    transform: rotate(180deg);
  }

  .site-nav__sublink {
    display: block;
    padding: 0.65rem 0.8rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius);
  }

  .site-nav__sublink:hover,
  .site-nav__sublink[aria-current='page'] {
    background: var(--ivory);
    color: var(--coral-text);
  }

  .site-nav__mobile-extra {
    display: none;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-left: auto;
  }

  .menu-toggle {
    display: none;
  }

  /* Grand écran : navigation centrée, en-tête posé sur le hero */
  @media (min-width: 62.5em) {
    .site-nav {
      margin-left: clamp(2rem, 11vw, 12.5rem);
    }

    .site-header--overlay {
      position: absolute;
      inset: 0 0 auto;
      background: transparent;
    }
  }

  /* Téléphone et tablette : menu déroulant */
  @media (max-width: 62.49em) {
    .site-header__inner {
      min-height: 4.5rem;
      flex-wrap: wrap;
      gap: 0 1rem;
    }

    .site-header__actions {
      display: none;
    }

    .menu-toggle {
      display: inline-grid;
      place-items: center;
      width: 2.9rem;
      height: 2.9rem;
      margin-left: auto;
      margin-right: -0.5rem;
      padding: 0;
      border: 0;
      background: none;
      border-radius: var(--radius);
      cursor: pointer;
    }

    .menu-toggle :global(svg) {
      width: 1.6rem;
      height: 1.6rem;
    }

    .menu-toggle__close,
    .site-header.is-open .menu-toggle__open {
      display: none;
    }

    .site-header.is-open .menu-toggle__close {
      display: block;
    }

    .site-nav {
      flex-basis: 100%;
      padding: 0.5rem 0 1.5rem;
    }

    :global(html.js) .site-nav {
      display: none;
    }

    :global(html.js) .site-header.is-open .site-nav {
      display: block;
      max-height: calc(100dvh - 4.5rem);
      overflow-y: auto;
    }

    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .site-nav__item {
      border-bottom: 1px solid var(--line);
    }

    .site-nav__link,
    .site-nav__group-label {
      display: flex;
      width: 100%;
      padding: 1rem 0;
      font-size: 1.375rem;
      font-weight: 650;
      letter-spacing: -0.02em;
    }

    .site-nav__link::after {
      display: none;
    }

    .site-nav__toggle {
      display: none;
    }

    .site-nav__group-label {
      padding-bottom: 0.25rem;
    }

    .site-nav__sub {
      position: static;
      min-width: 0;
      padding: 0 0 0.75rem;
      background: none;
      border: 0;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .site-nav__sublink {
      padding: 0.55rem 0;
      font-size: 1.0625rem;
      color: var(--ink-2);
    }

    .site-nav__sublink:hover {
      background: none;
    }

    .site-nav__mobile-extra {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding-top: 1.25rem;
    }

    .site-nav__mobile-extra .btn {
      flex: 1 1 14rem;
    }
  }
</style>
