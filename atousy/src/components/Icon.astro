---
// Petites icônes au trait, héritent de currentColor.
interface Props {
  name: 'arrow' | 'chevron' | 'menu' | 'close';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg class={className} width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow' && <path d="M7 17 17 7M8.5 7H17v8.5" />}
  {name === 'chevron' && <path d="m6 9 6 6 6-6" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
</svg>
