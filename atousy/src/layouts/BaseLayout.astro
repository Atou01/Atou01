---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** En-tête transparent sur le hero (accueil). */
  overlayHeader?: boolean;
  /** Page à ne pas indexer (pages en préparation, légales à compléter…). */
  noindex?: boolean;
}

const { title, description, overlayHeader = false, noindex = false } = Astro.props;
// La page 404 n'a pas d'adresse propre (/404/ redirige) : ni canonique ni og:url.
const isNotFound = /^\/404(\.html|\/)?$/.test(Astro.url.pathname);
const canonical = isNotFound ? undefined : new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og-image.jpg', site.url).href;
const ogImageAlt = 'Atousy, studio web & design : « Votre métier. Un site à part. » Création et refonte de sites pour artisans, TPE et PME.';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f8f4ee" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Avant l'affichage : active le mode JS et reprend le marché choisi (évite un saut de prix).
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var choice = null;
        var auto = null;
        try {
          choice = localStorage.getItem('atousy-market');
          auto = sessionStorage.getItem('atousy-market-auto');
        } catch (e) {}
        // 1. choix manuel ; 2. pays posé par Cloudflare (data-market déjà présent) ;
        // 3. détection de la session ; 4. Europe · EUR par défaut.
        if (choice === 'ch' || choice === 'fr') d.setAttribute('data-market', choice);
        else if (!d.hasAttribute('data-market')) d.setAttribute('data-market', auto === 'ch' ? 'ch' : 'fr');
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header overlay={overlayHeader} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/market';
    </script>
  </body>
</html>
