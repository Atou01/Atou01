---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** En-tête transparent sur le hero (accueil). */
  overlayHeader?: boolean;
  /** Page à ne pas indexer (pages en préparation, légales à compléter…). */
  noindex?: boolean;
}

const { title, description, overlayHeader = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og-image.jpg', site.url).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f8f4ee" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Avant l'affichage : active le mode JS et reprend le marché choisi (évite un saut de prix).
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var m = null;
        try {
          // Choix manuel en priorité, sinon pays déjà détecté pendant la session.
          m = localStorage.getItem('atousy-market') || sessionStorage.getItem('atousy-market-auto');
        } catch (e) {}
        // Sans JavaScript, aucun marché n'est posé : les deux prix restent visibles.
        d.setAttribute('data-market', m === 'ch' ? 'ch' : 'fr');
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header overlay={overlayHeader} />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/market';
    </script>
  </body>
</html>
