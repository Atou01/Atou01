# =====================================================================
# Hermes × Recrutement — secrets Phase 1
# Copier en .env (JAMAIS commité) et renseigner. Voir docs/guardrails.md.
# =====================================================================

# --- Provider LLM ---------------------------------------------------
# Hermes gère aussi cela via `hermes setup model`. Renseigne la clé de TON provider.
# Exemple OpenRouter :
OPENROUTER_API_KEY=changeme
# Exemple Anthropic direct (alternative) :
# ANTHROPIC_API_KEY=changeme

# --- Telegram (requis Phases 0 et 1) --------------------------------
# Bot créé via @BotFather ; chat_id = destinataire des rapports / source des déblocages CP1.
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_CHAT_ID=changeme

# --- Phase 0 : tunnel SSH + Chrome CDP (Mac → VPS) ------------------
# Utilisé par scripts/mac-tunnel.sh (Mac) et les checks CDP (VPS).
VPS_HOST=changeme            # ex: hermes@1.2.3.4 (user@IP du VPS)
SSH_PORT=22
CDP_PORT=9222
# CHROME_PROFILE=$HOME/.hermes-cdp-profile   # profil Chrome isolé (défaut)
# CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# =====================================================================
# Phase 2 — décommenter quand on y arrive (NON utilisé en Phase 1)
# =====================================================================
# CVthèque / base de données (Supabase = données, PAS l'hôte de Hermes)
# SUPABASE_URL=changeme
# SUPABASE_KEY=changeme
#
# Gmail / Google Calendar (via MCP) — planification entretiens/relances
# GOOGLE_OAUTH_CLIENT_ID=changeme
# GOOGLE_OAUTH_CLIENT_SECRET=changeme
#
# Pipeline candidats (via MCP)
# NOTION_API_KEY=changeme
# MONDAY_API_KEY=changeme
#
# HelloWork : volontairement EXCLU de la Phase 1 (France Travail Pro + LinkedIn suffisent).
